<h1 class="text-danger text-center mb-3">DEFINIÇÕES DO SISTEMA</h1>
<hr>

<div class="container-fluid px-0">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 mb-3">
        <div class="col">
            <a href="/admin/backup" class="menu-item2 card text-decoration-none text-light bg-secondary h-100">
                <div class="card-body d-flex align-items-center justify-content-center text-center p-4">
                    <span class="h5 mb-0">Backup</span>
                </div>
            </a>
        </div>
        <div class="col">
            <a href="/pedagogico/#" class="menu-item2 card text-decoration-none text-light h-100">
                <div class="card-body d-flex align-items-center justify-content-center text-center p-4">
                    <span class="h5 mb-0"></span>
                </div>
            </a>
        </div>
        <div class="col">
            <a href="#" onclick="atribuirCargo()" class="menu-item2 card text-decoration-none text-light bg-secondary h-100">
                <div class="card-body d-flex align-items-center justify-content-center text-center p-4">
                    <span class="h5 mb-0">Atribuir Cargo</span>
                </div>
            </a>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
        <div class="col">
            <a href="/definicoes/autorizacoes" class="menu-item2 card text-decoration-none text-light bg-secondary h-100">
                <div class="card-body d-flex align-items-center justify-content-center text-center p-4">
                    <span class="h5 mb-0">Autorizações</span>
                </div>
            </a>
        </div>
        <div class="col">
            <a href="/pedagogico/#" class="menu-item2 card text-decoration-none text-light bg-warning h-100">
                <div class="card-body d-flex align-items-center justify-content-center text-center p-4">
                    <span class="h5 mb-0"></span>
                </div>
            </a>
        </div>
        <div class="col">
            <a href="#" onclick="removerCargo()" class="menu-item2 card text-decoration-none text-light bg-secondary h-100">
                <div class="card-body d-flex align-items-center justify-content-center text-center p-4">
                    <span class="h5 mb-0">Remover Cargo</span>
                </div>
            </a>
        </div>
    </div>
</div>

<hr>

<div class="d-flex flex-wrap gap-2">
    <button onclick="nivelPrivilegio()" class="btn btn-light border">Promover Nível de privilegio</button>
    {{#if dev}}
    <button onclick="pagamento()" class="btn btn-light border">Pagamento</button>
    <a href="/admin/contactosAlunos" class="btn btn-light border">Contactos dos Alunos</a>
    <button onclick="restringirAccess()" class="btn btn-light border">Restrição de acesso</button>
    <button onclick="redefinicaoDeSenha()" class="btn btn-light border">Redefinição de senha</button>
    <button onclick="bloquearSystem()" class="btn btn-danger">Bloquear System</button>
    {{/if}}
</div>

<!-- Modal Atribuir Cargo -->

<div class="modal" tabindex="-1" data-bs-backdrop="static" id="atribuirCargo">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/definicoes/atribuirCargo" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title bg-primary p-2 text-center fw-bold text-light w-100">Atribuir Função / Cargo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label for="atribuirCargoFuncionario" class="form-label">Funcionário</label>
                    <select name="funcionario" id="atribuirCargoFuncionario" class="form-select mb-3">
                        <option value="">Seleciona o funcionario</option>
                        {{#each funcionarios}}
                        <option value="{{_id}}">{{nome}}</option>
                        {{else}}
                        <option value="" disabled>Nenhum funcionário registrado</option>
                        {{/each}}
                    </select>

                    <label for="atribuirCargoCargo" class="form-label">Cargo</label>
                    <select name="cargo" id="atribuirCargoCargo" class="form-select">
                        <option value="">Seleciona o cargo</option>
                        <option value="Chefe de Secção">Chefe de Secção</option>
                        <option value="Coordenador de Curso">Coordenador de Curso</option>
                        <option value="Coordenador de Disciplina">Coordenador de Disciplina</option>
                        <option value="Coordenador de Turma">Coordenador de Turma</option>
                        <option value="Coordenador de Turno">Coordenador de Turno</option>
                        <option value="Júri Presidente">Júri Presidente</option>
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" onclick="mostrar2()">Continuar</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Modal Remover Cargo -->

<div class="modal" tabindex="-1" data-bs-backdrop="static" id="removerCargo">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/definicoes/removerCargo" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title bg-danger p-2 text-center fw-bold text-light w-100">Remover Função / Cargo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label for="removerCargoFuncionario" class="form-label">Funcionário</label>
                    <select name="funcionario" id="removerCargoFuncionario" class="form-select">
                        <option value="">Seleciona o funcionario</option>
                        {{#each funcionariosComCargo}}
                        <option value="{{_id}}">{{nome}}</option>
                        {{else}}
                        <option value="" disabled>Nenhum funcionário registrado</option>
                        {{/each}}
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" onclick="mostrar2()">Continuar</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Modal nivelPrivilegio -->
<div class="modal" tabindex="-1" data-bs-backdrop="static" id="nivelPrivilegio">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/definicoes/nivelPrivilegio" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title bg-primary p-2 text-center fw-bold text-light w-100">Nível de privilégio do Sistema</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label for="nivelPrivilegioUsuario" class="form-label">Usuário</label>
                    <select name="idUsuario" id="nivelPrivilegioUsuario" class="form-select mb-3">
                        <option value="">Seleciona o Usuário</option>
                        {{#each users}}
                        <option value="{{_id}}">{{username}}</option>
                        {{else}}
                        <option value="" disabled>Nenhum usuário registrado</option>
                        {{/each}}
                    </select>

                    <label for="nivelPrivilegioNivel" class="form-label">Nível</label>
                    <select name="nivel" id="nivelPrivilegioNivel" class="form-select">
                        <option value="">Seleciona</option>
                        <option value="1">Nível 1</option>
                        <option value="2">Nível 2</option>
                        <option value="3">Nível 3</option>
                        <option value="4">Nível 4</option>
                        <option value="5">Nível 5</option>
                        <option value="0">Nenhum</option>
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" onclick="mostrar2()">Continuar</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Modal pagamento -->
<div class="modal" tabindex="-1" data-bs-backdrop="static" id="pagamento">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/definicoes/pagamento" method="post">
