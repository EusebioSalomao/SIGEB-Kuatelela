<!-- Modal autorizarMatricula -->
<div class="modal" tabindex="-1" data-bs-backdrop="static" id="autorizarMatricula">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/definicoes/autorizar" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title bg-primary p-2 text-center fw-bold text-light w-100">Autorizar Matriculas</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    {{#if definicoes.abrirReconfirmacao}}
                    <p class="text-danger">Esta função desactivará o botão de realizar a matrícula e a reconfirmação. Só os
                        funcionários permitidos terão acesso a esta funcionalidade.</p>
                    <p>Se deseja activar, clica em "Desactivar Autorização"</p>
                    {{else}}
                    <p>Esta função activará o botão de realizar a matrícula e a reconfirmação. Só os funcionários permitidos terão
                        acesso a esta funcionalidade.</p>
                    <p>Se deseja activar, clica em "Autorizar"</p>
                    {{/if}}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <input type="hidden" name="autorizacao" value="Matrículas">
                    {{#if definicoes.abrirReconfirmacao}}
                    <button type="submit" class="btn btn-danger">Desactivar Autorização</button>
                    {{else}}
                    <button type="submit" class="btn btn-primary">Autorizar</button>
                    {{/if}}
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Modal autorizarAdmissaoCandidato -->
<div class="modal" tabindex="-1" data-bs-backdrop="static" id="autorizarAdmissaoCandidato">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <form action="/definicoes/autorizar" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title bg-primary p-2 text-center fw-bold text-light w-100">Autorizar Admissão de Candidatos</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    {{#if definicoes.autorizarAdmissaoCandidato}}
                    <p class="text-danger">Esta função desactivará o botão que permite os Coordenadores admitirem os candidatos
                        inscritos. Só os funcionários permitidos terão acesso a esta funcionalidade.</p>
                    <p>Se deseja continuar, clica em "Desactivar Autorização"</p>
                    {{#each cursos}}
                    <input type="hidden" name="vagaRegular" min="0" value="0" class="lg-input-10">
                    <input type="hidden" name="vagaAdulto" min="0" value="0" class="lg-input-10">
                    {{/each}}

                    {{else}}
                    <p>Esta função activará o botão que permite aos Coordenadores de curso admitir candidatos inscritos. Só os
                        funcionários permitidos terão acesso a esta funcionalidade.</p>
                    <p>Se deseja activar, define as vagas por cada curso e clica em "Autorizar"</p>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr class="fw-bold text-primary fst-italic">
                                    <th>Cursos</th>
                                    <th>Nº Vagas Regular</th>
                                    <th>Nº Vagas Adultos</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each cursos}}
                                <tr>
                                    <td>{{descricao}}</td>
                                    <td class="text-center"><input type="number" name="vagaRegular" min="0" value="0" class="form-control lg-input-10"></td>
                                    <td class="text-center"><input type="number" name="vagaAdulto" min="0" value="0" class="form-control lg-input-10"></td>
                                </tr>
                                {{else}}
                                <tr>
                                    <td colspan="3" class="text-center">Nenhum Curso cadastrado</td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                    {{/if}}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <input type="hidden" name="autorizacao" value="Admissão de Candidato">
                    {{#if definicoes.autorizarAdmissaoCandidato}}
                    <button type="submit" class="btn btn-danger">Desactivar Autorização</button>
                    {{else}}
                    <button type="submit" class="btn btn-primary">Autorizar</button>
                    {{/if}}
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Modal lancamentoDeNotas -->
<div class="modal" tabindex="-1" data-bs-backdrop="static" id="lancamentoDeNotas">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <form action="/definicoes/lancamentoDeNotas" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title bg-primary p-2 text-center fw-bold text-light w-100">Autorização de Lançamento de Notas</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <label for="indicador" class="form-label">Indica a acção a proceder</label>
                    <select name="indicador" class="form-select text-center mb-3" required>
                        <option value="">Selecionar</option>
                        <option value="bloquear">Bloquear Lançamento</option>
                        <option value="autorizar">Autorizar Lançamento</option>
                    </select>

                    <select name="funcionario" class="form-select" aria-label="Seleciona o funcionário" required>
                        <option value="">Seleciona o Funcionário</option>
                        <option value="todos">--- Todos Professores ---</option>
                        {{#each funcionarios}}
                        <option value="{{_id}}">{{nome}}</option>
                        {{else}}
                        <option value="">Nenhum funcionário cadastrado</option>
                        {{/each}}
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <input type="hidden" name="autorizacao" value="Admissão de Candidato">
                    {{#if definicoes.autorizarAdmissaoCandidato}}
                    <button type="submit" class="btn btn-danger">Desactivar Autorização</button>
                    {{else}}
                    <button type="submit" class="btn btn-primary">Continuar</button>
                    {{/if}}
                </div>
            </div>
        </form>
    </div>
</div>

