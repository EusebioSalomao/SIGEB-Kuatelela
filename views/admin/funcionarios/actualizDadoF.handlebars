<div class="form-headear my-0">
    <div class="title">
        <h1 class="text-info">Caro professor! Actualiza os dados em falta por favor.</h1>
    </div>
</div>
<hr>
<div class="row mt-0">
    <div class="col-6 offset-3">
        {{#each erros}}
        <div class="alert alert-danger text-center">{{texto}}</div>
        {{else}}
        {{/each}}
    </div>
</div>
<div class="container">
    <div class="card input-box">
        <div class="card-body form-candidato mybox">
            <form action="/professor/saveActualizarDadosProf" method="post">

                <div class="row">
                    <div class="col-6 p-3">
                        <label for="nome">Nome:</label>
                        <input type="text" name="nome" value="{{professor.nome}}" class="form-control" disabled>
                        <div class="row">
                            <div class="col-6">
                                <label for="numBI">BI<span class="text-danger">*</span>:</label>
                                <input type="text" name="numBI" placeholder="nº Bilhete de identidade"
                                    class="form-control text-sm" required>
                            </div>
                            <div class="col-6">
                                <label for="contacto">Contacto: <span class="text-danger"></span></label>
                                <input type="tel" name="contacto" autocomplete="contacto" placeholder="9XX-XXX-XXX"
                                    class="form-control" pattern="^[0-9]{3}-[0-9]{3}-[0-9]{3}$">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6 mt-1">
                                <label for="genero">Genero<span class="text-danger">*</span>:</label><br>
                                <select name="genero" id="" required>
                                    <option value="selecionar">Selecionar</option>
                                    <option value="feminino">Feminino</option>
                                    <option value="masculino">Masculino</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label for="dataNascimento">Data de nascimento<span
                                        class="text-danger">*</span>:</label>
                                <input type="date" name="dataNascimento" class="form-control" required>

                            </div>
                        </div>

                        <div class="row">
                            <div class="col-9">

                                <input type="hidden" name="idProfessor" value="{{professor._id}}">
                                <a href="/professor/{{professor._id}}"
                                    class="btn btn-secondary mt-4">Cancelar</a>
                                <a href="#"><button type="submit" class="btn btn-success mt-4">Guardar</button></a>

                            </div>
                            <div class="col-3">

                            </div>
                        </div>
                    </div>
                    <div class="col-6 p-3">
                        <div class="lead text-danger">Dados adicionais</div>
                        <label for="especialidade">Especialidade:</label>
                        <div class="row">
                            <div class="col-6">
                                <input type="text" name="especialidade" class="form-control"
                                    placeholder="De acordo a sua formação" required>
                                <label for="funcao">Função:</label>
                                <select name="funcao" id="">
                                    <option value="{{professor.especialidade}}">{{professor.funcao}}</option>
                                </select><br>
                                <div class="row">
                                    <div class="col-6">
                                        <label for="morada">Agente:</label>
                                        <input type="text" name="agente" value="{{professor.numAgente}}" class="form-control" disabled>
                                    </div>
                                    <div class="col-6">
                                        <label for="morada">Morada:</label>
                                        <input type="text" name="morada" placeholder="Opcional" class="form-control" >
                                    </div>
                                </div>

                            </div>
                            <div class="col-6">
                                <div class="card">
                                    <div class="card-body">
                                        <img src="/uploads/{{professor.foto}}" class="fotoAluno" alt="Foto">
                                    </div>
                                </div>

                            </div>
                        </div>

                        <hr>

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>