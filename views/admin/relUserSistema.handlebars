<div class="container">
    <div class="h1 text-center">RELATÓRIO DE ACESSO AO SISTEMA</div>
</div>
<hr>
<div class="container">
    <table class="table table-striped table-hover">
        <thead>
            <tr class=" fw-bold">
                <td></td>
                <td>Usuario</td>
                <td>Nome completo</td>
                <td>Categoria</td>
                <td>Data de acesso</td>

            </tr>
        </thead>
        <tbody>
            {{#each relUsuarios}}
            <tr>
                <td> {{numVisualiz}} </td>
                <td>{{username}}</td>
                <td>{{nomeDoUsuario}}</td>
                <td>{{categoria}}</td>
                {{#if hoje}}
                <td class="px-4"> {{hoje}} - {{horaDeAcesso}} </td>
                {{else}}
                <td>{{diaDeAcesso}} de {{mesDeAcesso}} de {{anoDeAcesso}} </td>
                {{/if}}

                {{#if professor}}
                <td>
                    <a href="/professor/minipautasCadPAdmin/{{idProfessor}}" class="btn-light text-primary p-2 btn btn-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                            class="bi bi-eye" viewBox="0 0 16 16">
                            <path
                                d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z" />
                            <path
                                d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
                        </svg>
                    </a>
                </td>
                {{else}} <td></td> {{/if}}
            </tr>
            {{else}}
            {{/each}}
        </tbody>
    </table>
    <div class="text-center text-primary text-sm"><a href="" class="btn btn-sm text-info p-0 m-0">Ver lista de
            visitantes (Total {{visitantes.length}})</a></div>
</div>
<hr>
<div class="text-center"><a href="/user/allUsers"> <button class="btn mybtn-primary">Voltar a todos Usuários</button>
    </a></div>