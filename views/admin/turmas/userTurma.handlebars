<div class="container">
    <div class="h1 text-center">USUARIOS DA TURMA - {{turma.codigo}} </div>
</div>
<hr>
<div class="container">
    <table class="table table-striped table-hover">
        <thead>
            <tr class=" fw-bold">
                <td>N/O</td>
                <td>Nome completo</td>
                <td>Usuario</td>
                <td>Senha inicial</td>
                <td class="px-5">OBS</td>
                <td class="px-5"></td>

            </tr>
        </thead>
        <tbody>
            {{#each alunos}}
            <tr>
                <td class="px-2">{{numeroOrd}}</td>
                <td>{{nome}}</td>
                {{#if username}}
                <td>{{username}}</td>
                {{else}}
                <td><span class="text-danger">Sem Usuario</span><a href="/user/newUserAluno/{{_id}}">Criar Usuario</a>
                </td>
                {{/if}}
                <td>{{senha}}</td>
                {{#if hoje}}
                <td class="px-4"> {{hoje}} - {{horaDeAcesso}} </td>
                {{else}}
                <td> Alterado/Não alterado </td>
                {{/if}}

                <td>
                    {{#if editSenha}}
                    <form action="/definicoes/redefinicaoDeSenha/" method="post">
                        <input type="hidden" name="idUsuario" value="{{usuario}}" id="">
                        <input type="hidden" name="idTurma" value="{{idTurma}}" id="">
                        <button type="submit" class="btn btn-sm btn-light text-primary">Redefinir</button>
                    </form>
                    {{else}} {{/if}}
                </td>
            </tr>
            {{else}}
            {{/each}}
        </tbody>
    </table>
</div>
<hr>
<form action="/definicoes/redefinicaoDeSenha/" method="post">
    <div class="text-center">
        <a href="/turmas/turma/{{turma._id}}" class="btn btn-sm btn-warning"> Voltar</a>
        <a href="/turmas/userTurmaPDF/{{turma._id}}" class="btn btn-sm btn-secondary">Gerar PDF </a>
        {{#if nivelPrivilegio01}}
        <input type="hidden" name="idUsuario" value="turma" id="">
        <input type="hidden" name="idTurma" value="{{idTurma}}" id="">
        <button type="submit" class="btn btn-sm btn-primary">Redefinir todos</button>
        {{else}} {{/if}}
    </div>
</form>