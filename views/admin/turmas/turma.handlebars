    }

    async function pintarNomeAluno(botao) {
        const nome = botao.closest('.student-card')?.querySelector('.student-name span');
        if (!nome) return;

        const pintadoAtual = botao.dataset.pintado === 'true';
        const novoPintado = !pintadoAtual;
        const alunoId = nome.dataset.alunoId;

        botao.dataset.pintado = String(novoPintado);
        nome.dataset.pintado = String(novoPintado);
        nome.classList.toggle('text-danger', novoPintado);
        nome.style.color = novoPintado ? '#dc3545' : '#000000';
        botao.disabled = true;
        botao.title = novoPintado ? 'Pintar nome a preto' : 'Pintar nome a vermelho';
        botao.setAttribute(
            'aria-label',
            novoPintado
                ? 'Pintar o nome de ' + nome.textContent.trim() + ' a preto'
                : 'Pintar o nome de ' + nome.textContent.trim() + ' a vermelho',
        );

        try {
            const resposta = await fetch('/relatorios/pintarNomeAluno/' + encodeURIComponent(alunoId), {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                body: new URLSearchParams({ pintado: String(novoPintado) }),
            });
            if (!resposta.ok) {
                throw new Error('Não foi possível guardar o estado do aluno.');
            }
        } catch (error) {
            // Se o banco não aceitar a alteração, repõe o estado anterior na tela.
            botao.dataset.pintado = String(pintadoAtual);
            nome.dataset.pintado = String(pintadoAtual);
            nome.classList.toggle('text-danger', pintadoAtual);
            nome.style.color = pintadoAtual ? '#dc3545' : '#000000';
            console.error(error);
            alert('Não foi possível actualizar o estado do aluno.');
        } finally {
            botao.disabled = false;
        }
    }

    function numerarAlunos() {
        document.querySelectorAll('.students-list > li').forEach((aluno, index) => {
            const numero = aluno.querySelector(':scope > .student-number');
            if (numero) numero.textContent = (index + 1) + '.';
        });
    }

    numerarAlunos();

</script>