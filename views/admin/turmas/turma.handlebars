                            <input type="text" name="codigo" value="{{turma.codigo}}" class="form-control text-center"
                                id="">
                        </div>
                        <div class="card-body">
                            <div class="text-center">{{classe.designacao}}</div>
                            <div class="text-center">Curso: {{curso.descricao}}</div>
                        </div>
                    </div>
            </div>
            <div class="text-center p-3">
                <input type="hidden" name="idTurma" value="{{turma._id}}" id="">
                <input type="hidden" name="numBI" value="000Provisorio" id="">
                <input type="hidden" name="classe" value="{{classe.designacao}}" id="" class="form-control my-2">
                <input type="hidden" name="idClasse" value="{{classe._id}}" id="" class="form-control my-2">
                <input type="hidden" name="curso" value="{{curso.descricao}}" id="" class="form-control my-2">
                <input type="hidden" name="idCurso" value="{{curso._id}}" id="" class="form-control my-2">
                <button type="submit" class="btn btn-primary">Alterar</button>
            </div>
            </form>
        </div>

    </div>
</div>
</div>

{{!-- atribGenero --}}
<form action="/admin/atribGenero" method="post">
    <div class="modal" tabindex="-1" data-bs-backdrop="static" id="atribGenero">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title mytext-primary text-center">Atribui o genero correspondente a cada aluno -
                        <span> Turma: {{turma.codigo}} </span>
                    </h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <table class="table-bordered">


                        {{#each alunosSemGenero}}

                        <tr>

                            <td class="text-center"> {{numeroOrd}} </td>
                            <td class="px-2 lead"> {{nome}} </td>
                            <td class="text-center"> <select name="generos" id="">
                                    <option value="selecionar">Selecionar</option>
                                    <option value="M">Masculino</option>
                                    <option value="F">Feminino</option>
                                </select></td>
                        </tr>


                        {{else}}
                        <option class="h6 text-info text-center" value="0">Não foi achado nenhum aluno sem genero nesta
                            turma!</option>
                        {{/each}}
                    </table>
                    {{#if achado}}
                    <div class="text-sm text-danger text-center mt-2">
                        Antes de confirmar e salvar certifica-se que atribuio correctamente o genero de cada aluno!
                    </div>
                    <input type="hidden" name="idTurma" value="{{turma._id}}" id="">
                    <button type="submit" class="btn btn-primary mt-1 text-center">Confirmar e salvar</button>
                    {{else}}
                    {{/if}}


                </div>
                <div class="modal-footer text-center">
                    {{!-- <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Feichar</button>
                    --}}
                </div>
            </div>
        </div>
    </div>
</form>

{{!-- confirmarMatricula --}}
<form action="/admin/confirmarMatricula" method="post">
    <div class="modal" tabindex="-1" data-bs-backdrop="static" id="confirmarMatricula">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="text-center">

                    <h4 class="modal-title mytext-primary text-center"> Reconfirmação de Matriculas <span> Turma:
                            {{turma.codigo}} - {{classe.designacao}} </span></h4>
                    <span class="text-danger">Matricular na Classe/Turma:</span>
                    <select name="novaClasse">
                        <option value="">Selecionar</option>
                        <option value="{{turma._id}}"> <span class="text-danger"> Reprovados </span> </option>
                        {{#each turmas}}
                        <option value="{{_id}}"> {{idClasse.designacao}} - {{codigo}} </option>
                        {{else}}
                        <div class="text-center">Nemhuma turma registrada</div>
                        {{/each}}
                        {{#if finalistas}}
                        <option value="Concluido">Concluido</option>
                        {{else}}{{/if}}
                    </select>
                </div>
                <hr>
                <div class="modal-body ms-5">
                    <div class="row">
                        <div class="col-8">


                            <table class="table-bordered">


                                <tr class="text-center">
                                    <td>N/O</td>
                                    <td>Nome</td>
                                    <td class="px-2 camp-bilhete">Nº Bilhete de Identidade</td>
                                    <td class="px-2">Confirmado</td>
                                </tr>
                                {{#each alunos}}
                                <tr>

                                    <td class="text-center"> {{numOrdem}} </td>
                                    {{#if matriculado}}

                                    {{#if suspeito}} <td class="text-warning">{{nome}}</td> {{else}} <td class="">
                                        {{nome}}</td> {{/if}}

                                    {{else}}

                                    <td class=" text-danger">{{nome}}</td>
                                    {{/if}}
                                    <td class="text-center camp-bilhete">
                                        {{#if matriculado}}
                                        {{numBI}}
                                        <input type="hidden" name="numBI" value="{{numBI}}" id="">
                                        {{else}}
                                        <input type="text" name="numBI" id="">
                                        {{/if}}
                                    </td>
                                    <td class="text-center">
                                        {{#if matriculado}}
                                        {{#if suspeito}}
                                        <select name="confirmado" id="">
                                            <option value="">---</option>
                                            <option value="Confirmado"><span
                                                    class="text-success bg-success">Matriculado</span></option>
                                        </select>
                                        {{else}}
                                        {{!-- <span class="text-success">Matriculado</span> --}}
                                        <select name="confirmado" id="">
                                            <option value="Matriculado">Matriculado</option>
                                        </select>
                                        {{/if}}
                                        {{else}}
                                        <select name="confirmado" id="">
                                            <option value="">---</option>
                                            <option value="Confirmado"><span
                                                    class="text-success bg-success">Matriculado</span></option>
                                        </select>
                                        {{/if}}
                                    </td>
                                </tr>


                                {{else}}
                                <option class="h6 text-info text-center" value="0">Não foi achado nenhum aluno!</option>
                                {{/each}}
                            </table>
                        </div>
                        <div class="col-3">
                            <div class="h3 text-center mark text-danger">Atenção!</div>
                            <div class="lead text-justify">
                                <span class="text-danger text-sm fw-bold">Começa com as 12ª Classe</span><br>
                                Faça primeiro a reconfirmaçáo dos alunos aprovados de cada turma, selecionando <span
                                    class="text-sm fw-bold">confirmado</span> na última coluna aos nomes correspondentes
                                dos que reconfirmaram a matrícula.
                                <br>
                                <p class="my-1 text-success text-sm fw-bold">Aos alunos que terminaram a formação
                                    seleciona a turma "Concluido"</p>
                                Depois de certificar que todos alunos aprovados foram matriculados na nova classe, faça
                                a reconfirmação dos reprovados.
                                <hr>
                            </div>
                        </div>
                    </div>
                    <div class="text-center mt-2">

                        <input type="hidden" name="idTurma" value="{{turma._id}}" id="">
                        <button type="submit" class="btn btn-primary mt-1 text-center">Confirmar e salvar</button>
                    </div>




                </div>
                <div class="modal-footer text-center">
                    {{!-- <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Feichar</button>
                    --}}
                </div>
            </div>
        </div>
    </div>
</form>

{{!-- confirmarMatricula / Transferir* --}}
<form action="/admin/confirmarMatricula" method="post">
    <div class="modal" tabindex="-1" data-bs-backdrop="static" id="transfConfirmarMatricula">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="text-center">

