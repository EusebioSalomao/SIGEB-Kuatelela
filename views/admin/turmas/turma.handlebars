<main class="turma-page container-fluid py-4 py-lg-5">
    {{#if msg}}
    <div class="alert alert-success turma-alert text-center" role="alert">{{msg}}</div>
    {{/if}}
    {{#if exist}}
    <div class="alert alert-danger turma-alert text-center" role="alert">{{exist}}</div>
    {{/if}}

    <div class="container turma-shell">
        <header class="turma-header">
            <div class="turma-heading">
                <a class="btn btn-sm turma-back-button" href="/pedagogico/turmas" aria-label="Voltar para as turmas">
                    &larr; <span class="back-label">Voltar</span>
                </a>
                <div>
                    <p class="turma-eyebrow mb-1">Área pedagógica</p>
                    <h1 class="turma-title mb-0">
                        <span class="text-secondary">Turma:</span> {{turma.codigo}}
                    </h1>
                    <p class="turma-subtitle mb-0">
                        {{classe.designacao}}
                        <span class="turma-course-separator">/</span>
                        <span class="turma-course-description">{{curso.descricao}}</span>
                    </p>
                </div>
            </div>
            <div class="turma-header-actions">
                <a href="#" class="btn btn-sm turma-action-button" onclick="atribGenero()">At. Género</a>
                {{!-- <a href="#" class="btn btn-sm turma-action-button" onclick="addAluno()">+Aluno</a> --}}
                {{#if user._addAluno}}
                {{#if nivelPrivilegio01}}
                <a href="#" class="btn btn-sm turma-action-button" onclick="addAluno()">+Aluno</a>
                {{/if}}
                {{/if}}
                <a href="/pedagogico/turmas" class="btn btn-sm turma-action-button">Todas as turmas</a>
            </div>
        </header>

    {{#if alunosNaoReconfirmados}}
    <div class="text-center text-light bg-danger"> <span class="fw-bold">AVISO! </span> <span class="lead">
            - {{alunosNaoReconfirmados.length}} Estudantes desta turma ainda não reconfirmaram a Matrícula </span>
    </div>
    {{else}}{{/if}}
    <section class="turma-management mb-4">
        <div class="turma-management-row">
            <div class="turma-management-main">
                {{#if naoVagas}}
                <a href="#" class=" btn btn-sm btn-danger">Sem vaga!</a>
                <span class="turma-year-label text-light text-end">Ano {{ano.codigo}}</span>
                {{else}}

                {{#if user._matricuarAluno}}

                {{#if definicoes.abrirReconfirmacao}}
                {{#if classe10}}
                <a href="#" class="btn btn-sm btn-secondary btn-matricular" onclick="matricular()">+ Matricular novo aluno</a>
                <a href="#" class="btn btn-sm btn-primary btn-confirmar-matricula" onclick="confirmarMatricula()">Confirmar matricula</a>
                {{else}}
                <a href="#" class="btn btn-sm btn-primary btn-confirmar-matricula" onclick="confirmarMatricula()">++ Confirmar matricula</a>
                {{/if}}
                {{else}}{{/if}}
                {{else}}{{/if}}
                <span class="turma-period text-light">Ano {{ano.codigo}} - <span class="fw-bold"> {{turma.periodo}}
                    </span></span>

                {{/if}}

            </div>
            <div class="turma-management-actions">
                {{#if user._matricuarAluno}}
                <button class="btn btn-sm btn-light" onclick="incluirAluno()">Incluir+</button>
                <button class="btn btn-sm btn-light" onclick="transfConfirmarMatricula()">*Transferencias</button>
                <a href="#" class="btn btn-sm btn-light">Alunos</a>
                {{else}}{{/if}}

                {{#if user._professoresTurma}}
                <a href="/turmas/pturma/{{turma._id}}" class="btn btn-sm mybtn-color text-light">Professores</a>
                {{else}}{{/if}}
            </div>
        </div>
    </section>

    <section class="students-section" aria-labelledby="students-heading">
        <h2 id="students-heading" class="section-title">Alunos matriculados</h2>
        <div class="students-table-head d-none d-md-grid" aria-hidden="true">
            <span>Foto</span>
            <span>Nome completo</span>
            <span>Idade</span>
            <span>Género</span>
            <span>Ações</span>
        </div>
        <ul class="students-list">
            {{#each alunosMatriculados}}
            <li class="student-row" style="display: flex; align-items: center; gap: 0.5rem;">
                <span class="student-number text-secondary"
                    style="display: inline-flex; align-items: center; justify-content: flex-end; flex: 0 0 2rem;"
                    aria-label="Número do aluno"></span>
                <div class="student-card" style="flex: 1 1 auto; min-width: 0;">
                    <div class="student-photo">FOTO</div>
                    <div class="student-name">
                            {{#if matriculado}}
                            <span class="h5 mb-0 {{#if pintado}}text-danger{{/if}}"
                                data-aluno-id="{{_id}}"
                                data-pintado="{{#if pintado}}true{{else}}false{{/if}}">
                                {{nome}}
                            </span>
                            {{else}}
                            <span class="h5 mb-0 text-danger"
                                data-aluno-id="{{_id}}"
                                data-pintado="{{#if pintado}}true{{else}}false{{/if}}">
                                {{nome}}
                            </span>
                            {{/if}}
                    </div>
                    <div class="student-age">{{idade}} anos</div>
                    <div class="student-gender">{{genero}}</div>
                    <div class="student-actions">
                        <button type="button"
                            class="btn btn-sm btn-light p-1"
                            title="Pintar nome a vermelho"
                            aria-label="Pintar o nome de {{nome}} a vermelho"
                            data-pintado="{{#if pintado}}true{{else}}false{{/if}}"
                            onclick="pintarNomeAluno(this)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                aria-hidden="true">
                                <path d="M12 20h9"/>
                                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                            </svg>
                        </button>
                        <a href="/alunos/ficha/{{_id}}" class="bg-info text-light btn btn-sm" aria-label="Ver ficha de {{nome}}">i</a>
                                        {{!-- <a href="/admin/apagarAluno/{{_id}}" method="get"> <button
                                                class="btn btn-danger btn-sm">Apagar</button> </a> --}}
                                        {{#if _anularMatricula}}
                                        <a href="/admin/anularMatricula/{{_id}}" class="btn btn-warning btn-sm">Anular M</a>
                                        {{/if}}
                    </div>
                </div>

            </li>
            {{else}}
            {{/each}}

        </ul>
    </section>

    <section class="turma-footer-actions text-center" aria-label="Ações da turma">
        <a href="/turmas/minipauta/{{turma._id}}" class="btn btn-sm btn-primary">Minipauta</a>
        <a href="/turmas/gerarLista/{{turma._id}}" class="btn btn-sm btn-primary">Listas</a>
        <a id="actual-pdf-link" href="/relatorios/actualPDF/{{turma._id}}" class="btn btn-sm mybtn-primary">Lista Presença PDF</a>
        {{#if user._editarTurma}}
        <button type="submit" class="btn btn-sm mybtn-primary" onclick="editarTurma()">Editar dados da turma</button>
        <button type="submit" class="btn btn-sm btn-danger" onclick="eliminarTurma()">Eliminar</button>
        {{/if}}
        <a href="/relatorios/listaAlunosPDF/{{turma._id}}" class="btn btn-sm btn-secondary">Lista PDF</a>
        <a href="/relatorios/minipautaPDF/{{turma._id}}" class="btn btn-sm btn-secondary">Minipauta PDF</a>
        <a href="/turmas/controlFaltas/{{turma._id}}" class="btn btn-sm btn-primary">Faltas</a>
        <a href="/turmas/usuariosTurma/{{turma._id}}" class="btn btn-sm btn-primary">Usuários</a>
        <a href="/turmas/userTurmaPDF/{{turma._id}}" class="btn btn-sm mybtn-primary">Gerar PDF</a>
        <button class="btn btn-sm btn-primary" onclick="transferirAluno()">Transferir</button>
    </section>

{{!-- Alunos suspeitos --}}
{{#if alunosSuspeitos}}
<div class="text-center text-danger lead">Os nomes dos estudantes abaixo são suspeito. É provável que não têm
    frequentado a clesse anterior ou vieram transferidos de uma outra escola!</div>
{{#each alunosSuspeitos}}
<div class="text-center">

    <span class="text-center text-danger text-sm "> {{nome}} </span>;
</div>
{{else}}
{{/each}}
{{else}} {{/if}}

</div>

{{!-- Funções que serão apresentadas apenas para o dev --}}
{{#if dev}}
<hr>
<div class="container">
    <div class="text-center">
        <a href="/admin/anularMatriculaTDTurma/{{turma._id}}" class="btn btn-sm btn-danger">Anular
            Matriculas</a>
        <a href="/admin/actualizarIdAnoActivo" class="btn btn-sm btn-danger">Actualizar Id Ano
            Lectivo</a>
    </div>
</div>
{{else}}{{/if}}
</main>






<!-- Modal Matricular-->

<div class="modal fade" tabindex="-1" data-bs-backdrop="static" id="matricular">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Nova Matricula: - {{classe10}}</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="container">
                {{#each candMatricular}}
                <form action="/turmas/novaMatricula" method="post">
                    <div class="card">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-1"> {{numeroOrd}} </div>
                                <div class="col-3 h3"> FOTO </div>
                                <div class="col-3"> {{nome}} </div>
                                <div class="col-2"> {{idade}} anos </div>
                                <div class="col-3">
                                    <input type="hidden" name="idCandidato" value="{{_id}}">
                                    <input type="hidden" name="idTurma" value="{{idTurma}}">
                                    <button type="submit" class="btn btn-dark btn-sm">Matricular</button>
                                    {{!-- <a href="#" class="btn btn-info btn-sm text-light">+ informações</a> --}}
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
                {{else}}
                <h3 class="text-danger">Não ha mais candidato admitido neste curso</h3>
                {{/each}}
            </div>

            <div class="modal-footer text-center">
                <div class="lead text-info">Apenas candidatos admitidos constam nessa lista</div>
            </div>
        </div>
    </div>
</div>

<!-- Modal addProfessor-->
<div class="modal" tabindex="-1" data-bs-backdrop="static" id="addProfessor">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Selecionar Professor: - {{classe10}} {{turma.codigo}} </h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="container">
                {{#each candMatricular}}
                <form action="/turmas/novaMatricula" method="post">
                    <div class="card">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-3 h2"> FOTO </div>
                                <div class="col-3"> {{nome}} </div>
                                <div class="col-3"> {{idade}} anos </div>
                                <div class="col-3">
                                    <input type="hidden" name="idCandidato" value="{{_id}}">
                                    <input type="hidden" name="idTurma" value="{{idTurma}}">
                                    <button type="submit" class="btn btn-dark btn-sm">Matricular</button>
                                    <a href="#" class="btn btn-info btn-sm text-light">+ informações</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
                {{else}}
                <h3 class="text-danger">Não ha mais candidato admitido neste curso</h3>
                {{/each}}
            </div>

            <div class="modal-footer text-center">
                <div class="lead text-info">Apenas candidatos admitidos constam nessa lista</div>
            </div>
        </div>
    </div>
</div>

<!-- Modal addAluno com prioridade-->
