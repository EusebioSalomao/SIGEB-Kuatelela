{{!-- M O D A I S --}}

<!-- Modal -->
<div class="modal" tabindex="-1" data-bs-backdrop="static" id="solicitar">
  <div class="modal-dialog modal-dialog-centered">
    <form action="/informaAqui/solicitar" method="post">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Escolhe o tipo de solicitação</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="tipoSolicitacao" class="form-label">Tipo de solicitação</label>
            <select name="tipo" id="tipoSolicitacao" class="form-select">
              <option value="selecionar">Selecionar</option>
              <option value="RUPE">Solicitação da RUPE</option>
              <option value="emicaoDeDec">Emição de Declaração</option>
              <option value="justficativo">Justificação de Faltas</option>
              <option value="emicaoDeCertif">Emição de Certificado</option>
              <option value="decServiço">Declaração de serviço</option>
            </select>
          </div>

          <div class="mb-1">
            <label for="numBI" class="form-label">Número do Bilhete de Identidade</label>
            <input type="text" name="numBI" id="numBI" class="form-control"
              placeholder="Digite o número do Bilhete de identidade" required>
          </div>
        </div>
        <div class="modal-footer justify-content-center">
          <button type="submit" class="btn btn-primary">Enviar solicitação</button>
        </div>
      </div>
    </form>
  </div>
</div>


<script src="assets/bootstrap.bundle.min.js"></script>
<script>
  function solicitar() {
    let el = document.getElementById('solicitar');
    let minha_modal = new bootstrap.Modal(el);
    minha_modal.show();
  }
</script>
