<link rel="stylesheet" href="/css/turmas.css">

<main class="turmas-page container-fluid py-4 py-lg-5">
    <div class="container turmas-shell">
        {{#if msg}}
        <div class="alert alert-success turmas-alert text-center" role="alert">{{msg}}</div>
        {{/if}}
        {{#if exist}}
        <div class="alert alert-danger turmas-alert text-center" role="alert">{{exist}}</div>
        {{/if}}

        <header class="turmas-header">
            <div>
                <p class="turmas-eyebrow mb-1">Gestão escolar</p>
                <h1 class="turmas-title mb-0">
                    <span class="text-secondary">Ano Lectivo:</span> {{anoLectivo.codigo}}
                </h1>
            </div>
        </header>

        <hr class="turmas-divider">

        <div class="turmas-toolbar bg-secondary">
            <a href="/secretaria" class="btn btn-sm btn-warning">Voltar</a>
            <span class="turmas-toolbar-title">LISTA DAS TURMAS POR CLASSES</span>
        </div>

        <div class="accordion turmas-accordion" id="turmasAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingTurmas10">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapseTurmas10" aria-expanded="true" aria-controls="collapseTurmas10">
                        Turmas - 10ª Classe
                    </button>
                </h2>
                <div id="collapseTurmas10" class="accordion-collapse collapse show"
                    aria-labelledby="headingTurmas10" data-bs-parent="#turmasAccordion">
                    <div class="accordion-body">
                        <div class="row g-3">
                            {{#each turmas10}}
                            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                <article class="turma-card turma-card-10 text-light">
                                    <div class="turma-card-label">Turma</div>
                                    <h3 class="turma-card-code">{{codigo}}</h3>
                                    <a href="/secretaria/turma/{{_id}}" class="btn btn-sm btn-dark">Entrar</a>
                                    <p class="turma-card-help mb-0">Entra para ver mais informações</p>
                                </article>
                            </div>
                            {{else}}
                            <div class="col-12">
                                <p class="turmas-empty mb-0">Nenhuma turma da 10ª classe foi criada</p>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header" id="headingTurmas11">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapseTurmas11" aria-expanded="false" aria-controls="collapseTurmas11">
                        Turmas - 11ª Classe
                    </button>
                </h2>
                <div id="collapseTurmas11" class="accordion-collapse collapse"
                    aria-labelledby="headingTurmas11" data-bs-parent="#turmasAccordion">
                    <div class="accordion-body">
                        <div class="row g-3">
                            {{#each turmas11}}
                            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                <article class="turma-card turma-card-11 text-light">
                                    <div class="turma-card-label">Turma</div>
                                    <h3 class="turma-card-code">{{codigo}}</h3>
                                    <a href="/secretaria/turma/{{_id}}" class="btn btn-sm btn-dark">Entrar</a>
                                    <p class="turma-card-help mb-0">Click para ver mais informações</p>
                                </article>
                            </div>
                            {{else}}
                            <div class="col-12">
                                <p class="turmas-empty mb-0">Nenhuma turma da 11ª classe foi criada</p>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                </div>
            </div>

            {{!-- TURMAS DA 12ª CLASSE --}}
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingTurmas12">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapseTurmas12" aria-expanded="false" aria-controls="collapseTurmas12">
                        Turmas - 12ª Classe
                    </button>
                </h2>
                <div id="collapseTurmas12" class="accordion-collapse collapse"
                    aria-labelledby="headingTurmas12" data-bs-parent="#turmasAccordion">
                    <div class="accordion-body">
                        <div class="row g-3">
                            {{#each turmas12}}
                            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                <article class="turma-card turma-card-12 text-light">
                                    <div class="turma-card-label">Turma</div>
                                    <h3 class="turma-card-code">
                                        {{codigo}}
                                        <span class="turma-card-course text-dark">{{idCurso.sigla}}</span>
                                    </h3>
                                    <a href="/secretaria/turma/{{_id}}" class="btn btn-sm btn-dark">Entrar</a>
                                    <p class="turma-card-help mb-0">Click para ver mais informações</p>
                                </article>
                            </div>
                            {{else}}
                            <div class="col-12">
                                <p class="turmas-empty mb-0">Nenhuma turma da 12ª classe foi criada</p>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>