
    <div class="row">
        <div class="col-6">
            <h1>Adicionar Candidatos</h1>

        </div>
        {{#if curso}}

        <div class="col-5 text-end lead text-italic"> {{curso}} </div>
        {{else}}
        <div class="col-5 text-end lead text-italic"> <a href="/candidatos/solicitacoes" class="btn"> Solicitações:(
                <span class="text-danger">{{solcitCandidatura.length}}</span> ) </a> </div>
        {{/if}}
    </div>
    <hr>
<form action="/homeCoordenacao/adicionarCandidatoSave" method="post">
    <div class="card col-10 offset-1 input-box2">
        <div class="card-body">
        <table class="table">

        <tr class="text-center fw-bold">  <td>N/O</td> <td>Nome completo</td> <td>Genero</td> <td>Nº do BI</td> <td> Ano de nascimeento </td> <td> Média </td></tr>
        <tbody>
            {{#each vagasCandidatos}}
            <tr>
                    <td> {{numOrdem}} </td>
                <td>
                <input type="text" name="nome" class="lg-input-50" required>
                </td>
                <td>
                    <select name="genero" required>
                        <option value="">---</option>
                        <option value="M">Masculino</option>
                        <option value="F">Feminino</option>
                    </select>
                </td>
                <td>
                <input type="text" name="numBI" class="">
                </td>
                <td class="text-center">

                <select name="anoNascimento" >
                    <option value="">---</option>
                    <option value="2011">2011</option>
                    <option value="2012">2012</option>
                    <option value="2013">2013</option>
                    <option value="2014">2014</option>
                    <option value="2013">2013</option>
                    <option value="2012">2012</option>
                    <option value="2011">2011</option>
                    <option value="2010">2010</option>
                    <option value="2009">2009</option>
                    <option value="2008">2008</option>
                    <option value="2007">2007</option>
                    <option value="2006">2006</option>
                    <option value="2005">2005</option>
                    <option value="2004">2004</option>
                    <option value="2003">2003</option>
                    <option value="2002">2002</option>
                    <option value="2001">2001</option>
                    <option value="2000">2000</option>
                    <option value="1999">1999</option>
                    <option value="1998">1998</option>
                    <option value="1997">1997</option>
                    <option value="1996">1996</option>
                    <option value="1995">1995</option>
                    <option value="1994">1994</option>
                    <option value="1993">1993</option>
                    <option value="1992">1992</option>
                    <option value="1991">1991</option>
                    <option value="1990">1990</option>
                    <option value="1989">1989</option>
                    <option value="1988">1988</option>
                    <option value="1987">1987</option>
                    <option value="1986">1986</option>
                    <option value="1985">1985</option>
                    <option value="1984">1984</option>
                    <option value="1983">1983</option>
                    <option value="1982">1982</option>
                    <option value="1981">1981</option>
                    <option value="1980">1980</option>
                    <option value="1979">1979</option>
                    <option value="1978">1978</option>
                    <option value="1977">1977</option>
                    <option value="1976">1976</option>
                    <option value="1975">1975</option>
                    <option value="1974">1974</option>
                </select>
                </td>
                <td>
                <input type="number" name="media" class="lg-input-12" min="0" max="20" required>
                </td>
            </tr>
            {{else}}
            {{/each}}
        </tbody>
        </table>

    <div class="text-center">
        <input type="hidden" name="idCurso" value="{{idCurso}}">
        <input type="hidden" name="idCoord" value="{{idCoord}}">
        <a href="#" class="btn btn-secondary">Voltar</a>
        <button type="submit" class="btn btn-success" >Inserir Candidatos</button>
        </div>        
        </div>
    </div>
    
    </form>