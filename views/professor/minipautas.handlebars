
<main class="minipautas-page">
    <div class="container">
        {{#if msg}}
        <div class="alert alert-success page-alert" role="alert">{{msg}}</div>
        {{/if}}
        {{#if exist}}
        <div class="alert alert-danger page-alert" role="alert">{{exist}}</div>
        {{/if}}

        <header class="page-heading">
            <div>
                <span class="eyebrow">Gestão académica</span>
                <h1>Professor: <strong>{{professor.nome}}</strong></h1>
            </div>
            <div class="year-context">
                <span>Minipautas</span>
                <strong>{{ano.codigo}}</strong>
            </div>
        </header>

        <section class="intro-panel" id="lead1">
            <a href="/professor/{{professor.usuario}}" class="btn btn-outline-light btn-sm">Voltar ao perfil</a>
            <p>Minipautas das turmas que leciona durante o ano lectivo {{ano.codigo}}.</p>
        </section>

        {{!--
        <div class="text-end mb-3">
            <a href="#" onclick="addDisciplina()" class="btn btn-warning btn-sm">Adicionar disciplina</a>
        </div>
        --}}

        <section aria-labelledby="minipautas-title">
            <div class="section-heading">
                <span class="eyebrow">Acompanhamento de avaliações</span>
                <h2 id="minipautas-title">Minipautas atribuídas</h2>
            </div>

            {{#if minipautas.length}}
            <div class="minipautas-list">
                {{#each minipautas}}
                <article class="minipauta-card">
                    <div class="minipauta-summary">
                        <span class="subject-label">Disciplina</span>
                        <h3>{{nomeDisciplina}}</h3>
                        <p>{{idClasse.designacao}} <span aria-hidden="true">•</span> Turma <strong>{{idTurma.codigo}}</strong></p>
                        <a href="/professor/minipauta/{{_id}}" class="btn btn-primary btn-sm">Ver minipauta</a>
                    </div>
                    <div class="minipauta-info" id="info-mini">
                        <h4>Minipauta da {{idClasse.designacao}}, turma {{idTurma.codigo}}</h4>
                        <p class="assessment-line">
                            <strong>Notas lançadas:</strong>
                            {{#if lancadoAV1T1}}1ª AVCT1, {{/if}}
                            {{#if lancadoAV2T1}}2ª AVCT1, {{/if}}
                            {{#if lancadoAV3T1}}3ª AVCT1, {{/if}}
                            {{#if lancadoPPT1}}PPT1, {{/if}}
                            {{#if lancadoPTT1}}PTT1; {{/if}}
                            {{#if lancadoAV1T2}}1ª AVCT2, {{/if}}
                            {{#if lancadoAV2T2}}2ª AVCT2, {{/if}}
                            {{#if lancadoAV3T2}}3ª AVCT2, {{/if}}
                            {{#if lancadoPPT2}}PPT2, {{/if}}
                            {{#if lancadoPTT2}}PTT2; {{/if}}
                            {{#if lancadoAV1T3}}1ª AVCT3, {{/if}}
                            {{#if lancadoAV2T3}}2ª AVCT3, {{/if}}
                            {{#if lancadoAV3T3}}3ª AVCT3, {{/if}}
                            {{#if lancadoPPT3}}PPT3, {{/if}}
                            {{#if lancadoPTT3}}PTT3; {{/if}}
                            {{#if lancadoExameOral}}E. Oral, {{/if}}
                            {{#if lancadoExameEscrito}}E. Escrito{{/if}}
                        </p>
                        <div class="instruction">
                            <strong>OBS:</strong>
                            <span>Para inserir notas, clica em ver minipauta e em seguida clica em lançar nota. Selecione o trimestre e o tipo de avaliação que pretende, insere as notas dos alunos e confirma. Todas as notas são inseridas de uma só vez.</span>
                        </div>
                    </div>
                </article>
                {{/each}}
            </div>
            {{else}}
            <div class="empty-state">Nenhuma minipauta/carga atribuída</div>
            {{/if}}
        </section>
    </div>
</main>

<!-- Modal addClasse -->
<div class="modal fade" tabindex="-1" data-bs-backdrop="static" id="addClasse" aria-labelledby="addClasseTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/classes/add" method="post" class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title" id="addClasseTitle">Adicionar nova classe</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <label for="designacao" class="form-label">Designação:</label>
                <select name="designacao" required id="designacao" class="form-select mb-3">
                    <option value="selecionar">Selecionar</option>
                    <option value="10ª Classe">10ª classe</option>
                    <option value="11ª Classe">11ª Classe</option>
                    <option value="12ª Classe">12ª Classe</option>
                </select>
                <label for="numVagas" class="form-label">Nº Vagas:</label>
                <input type="number" name="numVagas" class="form-control mb-3" required id="numVagas">
                <label for="turnos" class="form-label">Turnos:</label>
                <select name="turnos" required id="turnos" class="form-select">
                    <option value="selecionar">Selecionar</option>
                    <option value="matinal">Matinal</option>
                    <option value="vespertino">Vespertino</option>
                    <option value="noturno">Noturno</option>
                    <option value="matVespertino">Matinal e Vespertino</option>
                    <option value="todos">Todos</option>
                </select>
                <input type="hidden" name="idCurso" value="{{curso._id}}">
                <input type="hidden" name="idAno" value="{{ano._id}}">
            </div>
            <div class="modal-footer"><button type="submit" class="btn btn-primary">Adicionar</button></div>
        </form>
    </div>
</div>

<!-- Modal addTurma -->
<div class="modal fade" tabindex="-1" data-bs-backdrop="static" id="addTurma" aria-labelledby="addTurmaTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/turmas/add" method="post" class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title" id="addTurmaTitle">Adicionar nova turma</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <label for="classe" class="form-label">Classe:</label>
                <select name="classe" required id="classe" class="form-select mb-3">
                    {{#if classe10}}<option value="10ª Classe">10ª classe</option>{{/if}}
                    {{#if classe11}}<option value="11ª Classe">11ª classe</option>{{/if}}
                    {{#if classe12}}<option value="12ª Classe">12ª classe</option>{{/if}}
                </select>
                <label for="codigo" class="form-label">Código:</label>
                <input type="text" name="codigo" placeholder="Digite o código da turma" required id="codigo" class="form-control mb-3">
                <label for="periodo" class="form-label">Período:</label>
                <select name="periodo" required id="periodo" class="form-select">
                    <option value="selecionar">Selecionar</option>
                    <option value="matinal">Matinal</option>
                    <option value="vespertino">Vespertino</option>
                    <option value="noturno">Noturno</option>
                </select>
                <input type="hidden" name="idCurso" value="{{curso._id}}">
                <input type="hidden" name="idAno" value="{{ano._id}}">
            </div>
            <div class="modal-footer"><button type="submit" class="btn btn-primary">Adicionar</button></div>
        </form>
    </div>
</div>

<!-- Modal addDisciplina -->
<div class="modal fade" tabindex="-1" data-bs-backdrop="static" id="addDisciplina" aria-labelledby="addDisciplinaTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/disciplinas/add" method="post" class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title" id="addDisciplinaTitle">Adicionar nova disciplina</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <label for="nomeDisciplina" class="form-label">Nome da disciplina:</label>
                <input type="text" name="nomeDisciplina" required id="nomeDisciplina" class="form-control mb-3">
                <label for="tempoLectivo" class="form-label">Tempo lectivo por semana:</label>
                <input type="text" name="tempoLectivo" required id="tempoLectivo" class="form-control">
                <input type="hidden" name="idClasse" value="{{classe._id}}">
                <input type="hidden" name="idCurso" value="{{curso._id}}">
                <input type="hidden" name="idAno" value="{{ano._id}}">
            </div>
            <div class="modal-footer"><button type="submit" class="btn btn-primary">Adicionar</button></div>
        </form>
    </div>
</div>

<script src="/assets/bootstrap.bundle.min.js"></script>
<script>
    function showModal(id) {
        const element = document.getElementById(id);
        if (element) new bootstrap.Modal(element).show();
    }
    function addClasse() { showModal('addClasse'); }
    function addTurma() { showModal('addTurma'); }
    function addDisciplina() { showModal('addDisciplina'); }
</script>