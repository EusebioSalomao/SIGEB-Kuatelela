                            class="nota-editavel text-center" data-campo="pt3" data-id-nota-disciplina="{{_id}}"
                            data-id-nota-trimestral="{{notas._id}}" tabindex="0" role="button"
                            title="Clique para editar a nota"> {{notas.pt3}} </td> {{/if}}
                        {{#if notas.negativaMT3}} <td class="media-calculada text-danger mybg-secondary  fw-bold text-center"
