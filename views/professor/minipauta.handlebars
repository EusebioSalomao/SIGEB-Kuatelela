{{#if msg}}
<div class="alert alert-success text-center minipauta-alert" role="status">{{msg}}</div>
{{/if}}
{{#if exist}}
<div class="alert alert-danger text-center minipauta-alert" role="alert">{{exist}}</div>
{{/if}}

<main class="container-fluid container-xl mini-prof">

    <div class="row lead-one align-items-stretch g-3" id="text-sm">
        <div class="col-12 col-lg-5 bg-secondary text-light py-3 px-4 minipauta-heading">
            <h1 class="h3 mb-0">Professor: {{minipauta.idProfessor.nome}} </h1>
        </div>
        <div class="col-12 col-lg-7 text-center p-3 mark minipauta-heading">
            <h2 class="h3 mb-0"><span class="text-secondary">Minipauta:</span> / {{minipauta.idClasse.designacao}}</h2>

        </div>
    </div>
    <hr>
    <div class="bg-secondary minipauta-guide">
        <div class="row align-items-center g-3 p-3">

            <div class="col-12" id="lead-mini">
                {{#if lancarNota}}
                <a href="/professor/minipautas/{{minipauta.idProfessor._id}}"
                    class="btn btn-sm bg-laranja text-light">Ver todas minipautas</a>
                {{else}}
                <a href="/pedagogico/minipautas" class="btn btn-sm bg-laranja text-light">Ver todas minipautas</a>
                {{/if}}
                <span class="text-light text-sm minipauta-guide-text">Veja e gira as notas dos teus alunos por meio desta
                    planilha — realize, no mínimo, duas avaliações por trimestre e guarde sempre uma via.</span>

            </div>

        </div>
    </div>
    <hr>
    <div class="row mark h3 fw-bold g-3 mb-4">
        <div class="col-12 col-md-6">
            <span class="text-secondary">Turma: </span> <span> {{minipauta.idTurma.codigo}} </span>
        </div>
        <div class="col-12 col-md-6 text-md-end">
            <span class="text-secondary">Disciplina: </span> <span> {{minipauta.nomeDisciplina}} </span>
        </div>

    </div>

    {{!-- TABELA DA MINIPAUTA --}}
    <div class="container-fluid p-0">
        <div class="row g-3 p-2 minipauta-actions">
            {{#if lancarNota}}
            <div class="text-danger text-center mark mb-3 text-sm" id="aviso1">Ilustre Docente. Pode voltar a lançar as notas que não
                aparecem.
                Se for apenas alguns alunos ou avaliação em atraso, clica no botão "Editar nota". Caso sejam notas de
                todos
                alunos numa determinada avaliação ou prova, clica em "Lançar outra vez". <span class="fw-bold"> Não
                    esqueça
                    de actualizar a pagina depois de lançar a nota, por favor!</span></div>
            <div class="row align-items-center g-2">
                <div class="col-12 col-xl-9">
                    {{#if minipauta.idProfessor.lancamentoDeNotas}}
                    <button onclick="lancarNota()" class="btn btn-sm btn-warning">Lançar nota</button>
                    <button onclick="lancarNota()" class="btn btn-sm btn-primary opacity-50">Lançar outra vez</button>
                    <span class="text-primary text-center">Depois do lançamento actualize a pagina por favor!</span>
                    {{else}}
                    <span class="text-primary text-center" id="lead-notaatraso">O Lançamento de nota não está disponível no momento. Contacta a
                        Direção!</span>
                    {{/if}}
                </div>
                <div class="col-12 col-xl-3 text-xl-end">
                {{!-- Se for autorizado a lançar --}}
                    {{#if minipauta.idProfessor.lancamentoDeNotas}}
                    {{!-- Funçãoque permite aos professores lançar notas das provas em atraso, ou editar uma nota --}}
                    <button id="btn-editar-nota" onclick="editarNota()" class="btn btn-sm btn-warning">Editar nota / Av. Atraso</button>
                    {{!-- Se não for autorizado a lançar --}}
                    {{else}}{{/if}}

                </div>
            </div>
            {{!-- PARA REPETIR LANÇAR --}}
            <form action="/professor/lancarNotaRep" method="post">

                {{#if msgFalhaLancada}}<div class="text-center">

                    <input type="hidden" name="idProfessor" value="{{minipauta.idProfessor._id}}">
                    <input type="hidden" name="idMinipauta" value="{{minipauta._id}}">
                    <input type="hidden" name="idClasse" value="{{minipauta.idClasse._id}}">
                    <input type="hidden" name="idTurma" value="{{minipauta.idTurma._id}}">
                    <input type="hidden" name="idCurso" value="{{curso._id}}">
                    <input type="hidden" name="idAno" value="{{ano._id}}">
                    <button type="submit" class="p-1 btn btn-sm btn-danger"> {{msgFalhaLancada}} </button>
                </div>{{else}}{{/if}}
            </form>
            {{else}}
            <div class="row">
                <div class="col-12 col-md-3"><button onclick="editarNota()" class="btn btn-sm btn-warning">Editar nota / Av.
                        Atraso</button></div>
                        
                <div class="col-12 col-md-6">
                    {{#if msgFalhaLancada}}<div class="text-center"> <button class="p-1 btn btn-sm btn-danger"> Algumas
                            notas não foram salvas. O professor deve repetir o lançamento! {{msgFalhaLancada}} </button>
                    </div>{{else}}{{/if}}
                </div>
                <div class="col-12 col-md-3 text-md-end">
                    <button onclick="lancarNota()" class="btn btn-sm btn-danger opacity-50">At. nota Admin</button>
                </div>
            </div>
            {{/if}}


        </div>
        <div class="table-responsive minipauta-table-wrap">
        <table class="table table-bordered text-center table-sm align-middle minipauta-table">
                <thead class="table-dark">
                    <tr class="fw-bold">
                        <th class="text-center pb-4" rowspan="2" scope="col">Nº</th>
                        <th class="text-center pb-4" rowspan="2" scope="col">Nome completo</th>
                        <th class="text-center bg-light text-secondary" colspan="3" scope="colgroup">1º Trimestre</th>
                        <th class="text-center bg-info" colspan="3" scope="colgroup">2º Trimestre</th>
                        <th class="text-center bg-secondary" colspan="3" scope="colgroup">3º Trimestre</th>
                        <th class="text-center bg-dark" colspan="3" scope="colgroup">CF</th>
                    </tr>
                    <tr>

                        {{!-- <td class="bg-light text-secondary">1ª Av</td>
                        <td class="bg-light text-secondary">2ª Av</td>
                        <td class="bg-light text-secondary">3ª Av</td> --}}
                        <th class="bg-light text-secondary" scope="col">MAC1</th>
