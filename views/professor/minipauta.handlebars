                        <th scope="col">MT</th>
                        <th scope="col">E</th>
                        <th scope="col">CF</th>


                    </tr>
                </thead>
                <tbody>
                {{#each notasDisciplina}}

                    <tr>
                        <td class="text-center bg-secondary"><span class="mx-0"> {{numeroOrd}} </span></td>

                        <td class="text-start"><span class="text-sm"> {{aluno.nome}} </span> </td>
