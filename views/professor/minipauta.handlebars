        <script>
            function lancarNota() {

                let el = document.getElementById('lancarNota');
                let minha_modal = new bootstrap.Modal(el);
                minha_modal.show();
            }

            function lancarNotaRep() {

                let el = document.getElementById('lancarNotaRep');
                let minha_modal = new bootstrap.Modal(el);
                minha_modal.show();
            }
            function editarNota() {

                let el = document.getElementById('editarNota');
                let minha_modal = new bootstrap.Modal(el);
                minha_modal.show();
            }

            function addTurma() {
                let el = document.getElementById('addTurma');
                let minha_modal = new bootstrap.Modal(el);
                minha_modal.show();
            }


             function addDisciplina() {
                 let el = document.getElementById('addDisciplina');
                 let minha_modal = new bootstrap.Modal(el);
                 minha_modal.show();
             }

             (() => {
                 const camposEditaveis = new Set([
                     'mac1', 'mac2', 'mac3',
                     'pt1', 'pt2', 'pt3',
                     'examePF'
                 ]);
                 const estadoLancamentoDeNotas = '{{minipauta.idProfessor.lancamentoDeNotas}}'
                     .trim()
                     .toLowerCase();
                 const valoresEAdmin = [
                     '{{eAdmin}}',
                     '{{isAdmin}}',
                     '{{user.eAdmin}}',
                     '{{usuario.eAdmin}}',
                     '{{utilizador.eAdmin}}'
                 ].map((valor) => valor.trim().toLowerCase());
                 const valoresPrivilegio = [
                     '{{privilegio}}',
                     '{{user.privilegio}}',
                     '{{usuario.privilegio}}',
                     '{{utilizador.privilegio}}'
                 ].map((valor) => valor.trim())
                     .filter((valor) => valor !== '')
                     .map((valor) => Number(valor));
                 const eAdmin = valoresEAdmin.some((valor) => (
                     ['true', '1', 'sim', 'yes'].includes(valor)
                 ));
                 const privilegioDoUtilizador = valoresPrivilegio.find((valor) => (
                     Number.isFinite(valor)
                 )) || 0;
                 const lancamentoDeNotasBloqueado = [
                     'false', '0', 'nao', 'não', 'no'
                 ].includes(estadoLancamentoDeNotas);
                 const podeEditarNotas = (
                     (eAdmin && privilegioDoUtilizador > 1) ||
                     !lancamentoDeNotasBloqueado
                 );
                 const mensagemBloqueioEdicao =
                     'A edição desta minipauta está bloqueada porque o lançamento de notas não está disponível.';

                 const formatarNota = (valor) => {
                     if (valor === null || valor === undefined || valor === '') return '';
                     const numero = Number(valor);
                     return Number.isFinite(numero) ? String(numero) : '';
                 };

                 const encontrarCelulasDaNota = (idNotaTrimestral) => {
                     return Array.from(document.querySelectorAll(
                         '.minipauta-table [data-id-nota-trimestral]'
                     )).filter((elemento) => (
                         elemento.dataset.idNotaTrimestral === idNotaTrimestral
                     ));
                 };

                 const actualizarMediasNaTabela = (nota, idNotaTrimestral) => {
                     const celulasDaNota = encontrarCelulasDaNota(idNotaTrimestral);

                     celulasDaNota.forEach((elemento) => {
                         const campo = elemento.dataset.campo;
                         if (Object.prototype.hasOwnProperty.call(nota, campo)) {
                             elemento.textContent = ` ${formatarNota(nota[campo])} `;
                         }
                     });

                     const linhaDaNota = celulasDaNota[0]?.closest('tr');
                     linhaDaNota?.querySelectorAll(
                         '.media-calculada[data-campo]'
                     ).forEach((elemento) => {
                         const campo = elemento.dataset.campo;
                         if (Object.prototype.hasOwnProperty.call(nota, campo)) {
                             elemento.textContent = ` ${formatarNota(nota[campo])} `;
                         }
                     });
                 };

                 const restaurarCelula = (elemento, valorOriginal) => {
                     elemento.replaceChildren(document.createTextNode(` ${valorOriginal} `));
                     delete elemento.dataset.editando;
                     elemento.removeAttribute('aria-busy');
                 };

                 const guardarNota = async (elemento, input, valorOriginal) => {
                     if (elemento.dataset.guardando === 'true') return;
                     if (input.dataset.cancelado === 'true') {
                         restaurarCelula(elemento, valorOriginal);
                         return;
                     }

                     const valor = input.value.trim().replace(',', '.');
                     const numero = Number(valor);

                     if (
                         valor === '' ||
                         !Number.isFinite(numero) ||
                         numero < 0 ||
                         numero > 20
                     ) {
                         restaurarCelula(elemento, valorOriginal);
                         return;
                     }

                     if (numero === Number(valorOriginal)) {
                         restaurarCelula(elemento, valorOriginal);
                         return;
                     }

                     elemento.dataset.guardando = 'true';
                     elemento.setAttribute('aria-busy', 'true');

                     try {
                         const resposta = await fetch('/professor/actualizarNotaMinipauta', {
                             method: 'POST',
                             headers: {
                                 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                                 'Accept': 'application/json'
                             },
                             body: new URLSearchParams({
                                 idNotaDisciplina: elemento.dataset.idNotaDisciplina,
                                 idNotaTrimestral: elemento.dataset.idNotaTrimestral,
                                 campo: elemento.dataset.campo,
                                 valor: String(numero)
                             })
                         });
                         const resultado = await resposta.json();

                         if (!resposta.ok || !resultado.ok) {
                             throw new Error(resultado.mensagem || 'Não foi possível guardar a nota.');
                         }

                         actualizarMediasNaTabela(
                             resultado.nota,
                             elemento.dataset.idNotaTrimestral
                         );
                         elemento.classList.add('border-success');
                         window.setTimeout(() => elemento.classList.remove('border-success'), 1200);
                     } catch (erro) {
                         console.error(erro);
                         restaurarCelula(elemento, valorOriginal);
                         window.alert(erro.message || 'Não foi possível guardar a nota.');
                     } finally {
                         delete elemento.dataset.guardando;
                         delete elemento.dataset.editando;
                         elemento.removeAttribute('aria-busy');
                     }
                 };

                 const iniciarEdicao = (elemento) => {
                     if (!podeEditarNotas) {
                         mostrarMensagemBloqueioEdicao();
                         return;
                     }

                     if (
                         !elemento ||
                         !camposEditaveis.has(elemento.dataset.campo) ||
                         elemento.dataset.editando === 'true' ||
                         elemento.dataset.guardando === 'true'
                     ) return;

                     const valorOriginal = elemento.textContent.trim();
                     const input = document.createElement('input');
                     input.type = 'number';
                     input.min = '0';
                     input.max = '20';
                     input.step = '0.01';
                     input.inputMode = 'decimal';
                     input.className = 'form-control form-control-sm text-center';
                     input.value = valorOriginal.replace(',', '.');
                     input.setAttribute('aria-label', `Editar ${elemento.dataset.campo}`);

                     elemento.dataset.editando = 'true';
                     elemento.replaceChildren(input);
                     input.focus();
                     input.select();

                     input.addEventListener('keydown', (evento) => {
                         if (evento.key === 'Enter') {
                             evento.preventDefault();
                             input.blur();
                         } else if (evento.key === 'Escape') {
                             evento.preventDefault();
                             input.dataset.cancelado = 'true';
                             restaurarCelula(elemento, valorOriginal);
                         }
                     });
                     input.addEventListener('blur', () => {
                         guardarNota(elemento, input, valorOriginal);
                     }, { once: true });
                 };

                 const tabela = document.querySelector('.minipauta-table');
                 if (!tabela) return;

                 const mostrarMensagemBloqueioEdicao = () => {
                     let aviso = document.getElementById('mensagemBloqueioEdicao');
                     if (!aviso) {
                         aviso = document.createElement('div');
                         aviso.id = 'mensagemBloqueioEdicao';
                         aviso.className = 'alert alert-warning text-center fw-bold mb-3';
                         aviso.setAttribute('role', 'alert');
                         aviso.style.position = 'sticky';
                         aviso.style.top = '0';
                         aviso.style.zIndex = '10';
                         document.querySelector('.minipauta-actions')?.prepend(aviso);
                     }
                     aviso.textContent = mensagemBloqueioEdicao;
                 };

                 if (!podeEditarNotas) {
                     document.querySelectorAll('.nota-editavel').forEach((elemento) => {
                         elemento.setAttribute('aria-disabled', 'true');
                         elemento.setAttribute('title', mensagemBloqueioEdicao);
                     });
                     mostrarMensagemBloqueioEdicao();
                 }

                 tabela.addEventListener('click', (evento) => {
                     iniciarEdicao(evento.target.closest('.nota-editavel'));
                 });

                 tabela.addEventListener('keydown', (evento) => {
                     if (evento.key === 'Enter' || evento.key === ' ') {
                         const elemento = evento.target.closest('.nota-editavel');
                         if (elemento && !elemento.dataset.editando) {
                             evento.preventDefault();
                             iniciarEdicao(elemento);
                         }
                     }
                 });
             })();



        </script>