<link rel="stylesheet" href="assets/css/alunos.css">

<div class="container-fluid px-3 px-md-4 py-3 alunos-page">

    {{#if msg}}
    <div class="alert alert-success text-center">{{msg}}</div>
    {{/if}}
    {{#if exist}}
    <div class="alert alert-danger text-center">{{exist}}</div>
    {{/if}}

    {{!-- Cabeçalho --}}
    <div class="row g-2 align-items-center mb-3 page-header">
        <div class="col-12 col-md-6">
            <div class="d-flex align-items-center gap-2">
                <a href="/pedagogico" class="btn btn-sm btn-outline-secondary" aria-label="Voltar">&larr;</a>
                <h1 class="h4 mb-0"><span class="text-secondary fw-semibold">Ano Lectivo:</span> {{anoLectivo.codigo}}</h1>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="d-flex flex-wrap gap-2 justify-content-start justify-content-md-end">
                <a href="/pedagogico/alunosConcluido" class="btn btn-sm btn-secondary">Alunos concluído</a>
                <a href="/pedagogico/alunosNaoMatriculados" class="btn btn-sm btn-secondary">Alunos não matriculados</a>
            </div>
        </div>
    </div>

    {{!-- Barra de título + pesquisa --}}
    <div class="bg-secondary text-light rounded p-2 p-md-3 mb-3">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-8">
                <span class="h6 text-uppercase mb-0 d-block">Relação nominal de todos alunos matriculados</span>
            </div>
            <div class="col-12 col-md-4">
                <div class="input-group input-group-sm search-box">
                    <span class="input-group-text bg-white text-secondary" aria-hidden="true">&#128269;</span>
                    <input type="text" name="pesqNomeAluno" id="pesqNomeAluno" class="form-control"
                        placeholder="Pesquisar pelo nome" aria-label="Pesquisar pelo nome">
                </div>
            </div>
        </div>
    </div>

    {{!-- Lista de alunos --}}
    <div class="alunos-list">
        {{#each alunos}}
        <div class="card aluno-card mb-2">
            <div class="card-body d-flex align-items-center gap-3 flex-wrap">
                <span class="aluno-num" aria-hidden="true"></span>
                <img src="/uploads/{{foto}}" class="fotoAluno" alt="Foto de {{nome}}">
                <div class="flex-grow-1 aluno-info">
                    <div class="fw-semibold aluno-nome">{{nome}}</div>
                    <div class="text-muted small">{{idade}} anos &middot; {{classe}}</div>
                </div>
                <a href="/alunos/ficha/{{_id}}" class="btn btn-sm btn-info text-light" aria-label="Ver ficha de {{nome}}">
                    <span aria-hidden="true">i</span>
                </a>
            </div>
        </div>
        {{else}}
        <div class="h5 text-center text-muted mt-4">Nenhum aluno matriculado</div>
        {{/each}}
        <div class="h6 text-center text-muted mt-4 d-none" id="alunoSemResultado">Nenhum aluno encontrado com esse nome</div>
    </div>

    <div class="mt-3">
        {{!-- <a href="/admin/actualizarNomesAlunos">Actualizar nomes</a> --}}
        <a href="/admin/actualizarIdAnoActivo" class="btn btn-sm btn-outline-secondary">Actualizar IdAno</a>
        <a href="/admin/verificarNomesRepetidos" class="btn btn-sm btn-outline-secondary">Verificar nomes Repetidos</a>
    </div>

    {{!-- Modal Matricular --}}
    <div class="modal" tabindex="-1" data-bs-backdrop="static" id="matricular">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="modal-title h5 mb-0">Nova Matrícula - {{classe10}}</h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    {{#each candMatricular}}
                    <form action="/turmas/novaMatricula" method="post" class="candidato-row mb-2">
                        <div class="card">
                            <div class="card-body d-flex align-items-center gap-3 flex-wrap">
                                <div class="photo-placeholder d-flex align-items-center justify-content-center">FOTO</div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">{{nome}}</div>
                                    <div class="text-muted small">{{idade}} anos</div>
                                </div>
                                <input type="hidden" name="idCandidato" value="{{_id}}">
                                <input type="hidden" name="idTurma" value="{{idTurma}}">
                                <a href="#" class="btn btn-sm btn-outline-info">+ informações</a>
                                <button type="submit" class="btn btn-dark btn-sm">Matricular</button>
                            </div>
                        </div>
                    </form>
                    {{else}}
                    <h3 class="h6 text-danger text-center mb-0">Não há mais candidatos admitidos neste curso</h3>
                    {{/each}}
                </div>

                <div class="modal-footer text-center">
                    <div class="small text-info mb-0">Apenas candidatos admitidos constam nessa lista</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="assets/bootstrap.bundle.min.js"></script>
<script>
    function matricular() {
        let el = document.getElementById('matricular');
        let minha_modal = new bootstrap.Modal(el);
        minha_modal.show();
    }

    function normalizarTexto(texto) {
        return texto
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toLowerCase()
            .trim();
    }

    function filtrarAlunos() {
        let termo = normalizarTexto(campoPesquisaAluno.value);
        let cartoes = document.querySelectorAll('.alunos-list .aluno-card');
        let algumVisivel = false;

        cartoes.forEach(function (cartao) {
            let nomeEl = cartao.querySelector('.aluno-nome');
            let nome = nomeEl ? normalizarTexto(nomeEl.textContent) : '';
            let corresponde = nome.includes(termo);

            cartao.classList.toggle('d-none', !corresponde);
            if (corresponde) {
                algumVisivel = true;
            }
        });

        let semResultado = document.getElementById('alunoSemResultado');
        if (semResultado) {
            semResultado.classList.toggle('d-none', algumVisivel || cartoes.length === 0);
        }
    }

    let campoPesquisaAluno = document.getElementById('pesqNomeAluno');
    if (campoPesquisaAluno) {
        campoPesquisaAluno.addEventListener('input', filtrarAlunos);
    }
</script>
