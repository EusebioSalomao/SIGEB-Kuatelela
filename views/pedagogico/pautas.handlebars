{{!-- MODAIS --}}

<!-- Modal gerearPauta -->
<form action="/pedagogico/gerarPauta" method="post">
    <div class="modal" tabindex="-1" data-bs-backdrop="static" id="gerearPauta">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="modal-title h5 mb-0">Gerar pauta</h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-pauta mb-3">
                        <span class="fw-bold">Atenção!</span> Antes de gerar uma pauta certifica-se de que todos
                        professores lançaram notas finais do período correspondente.
                    </div>

                    <div class="mb-3">
                        <label for="trimestre" class="form-label">Trimestre:</label>
                        <select name="trimestre" id="trimestre" class="form-select" required>
                            <option value="selecionar">Seleciona o Trimestre</option>
                            <option value="trimestre1">Primeiro Trimestre</option>
                            <option value="trimestre2">Segundo Trimestre</option>
                            <option value="trimestre3">Terceiro Trimestre</option>
                            <option value="pautaFinal">Pauta Final</option>
                        </select>
                    </div>

                    <div class="mb-2">
                        <label for="turma" class="form-label">Turma:</label>
                        <select name="turma" id="turma" class="form-select" required>
                            <option value="selecionar">Selecionar</option>
                            {{#each turmas}}
                            <option value="{{_id}}">{{codigo}}</option>
                            {{else}}
                            <option value="" disabled>Nenhuma turma registrada</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-pauta-outline" data-bs-dismiss="modal">Fechar</button>
                    <button type="submit" class="btn btn-pauta-primary">Gerar</button>
                </div>
            </div>
        </div>
    </div>
</form>

<script src="assets/bootstrap.bundle.min.js"></script>
<script>
    function gerearPauta() {
        let el = document.getElementById('gerearPauta');
        let minha_modal = new bootstrap.Modal(el);
        minha_modal.show();
    }
</script>
