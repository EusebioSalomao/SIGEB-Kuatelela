                    </div>
                </div>
            </div>
            {{else}}
            <div class="col-12">
                <p class="pauta-empty text-center mb-0">Nenhuma pauta 11ª Classe</p>
            </div>
            {{/each}}
        </div>
    </div>

    <div class="pauta-section">
        <h3 class="pauta-section-title">12ª Classe</h3>
        <div class="row g-3">
            {{#each pautas12}}
