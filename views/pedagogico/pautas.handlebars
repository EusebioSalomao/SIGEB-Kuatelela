<link rel="stylesheet" href="/assets/css/pautas.css">
{{!-- Nota: se este ficheiro é renderizado dentro de um layout com <head>,
     mova a tag <link> acima para lá. Deixei aqui para o CSS funcionar
     mesmo que este parcial seja usado de forma isolada. --}}

{{#if pautasAnual}}
{{!-- Pautas dos anos anteriores - Encerrados --}}
<div class="container-fluid pauta-page">

    <div class="pauta-header d-flex flex-wrap align-items-center justify-content-between gap-2 py-3">
        <div class="d-flex align-items-center gap-2">
            <a href="/anosLectivo" class="btn btn-pauta-outline btn-sm" aria-label="Voltar">&larr;</a>
            <h1 class="h4 mb-0">
                <span class="text-muted fw-normal">Ano Lectivo:</span>
                <span class="fw-semibold">{{anoLectivo.codigo}}</span>
            </h1>
        </div>
        <h2 class="h5 mb-0 pauta-title">Pautas</h2>
    </div>

    <div class="pauta-section mt-4">
        <h3 class="pauta-section-title">10ª Classe</h3>
        <div class="row g-3">
            {{#each pautas10}}
            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <div class="card pauta-card h-100 text-center">
                    <div class="card-body d-flex flex-column">
                        <span class="pauta-label">Pauta</span>
                        <div class="h5 mt-3 mb-1">{{classe.designacao}}</div>
                        <hr>
                        <div class="pauta-curso mb-2">{{curso.descricao}}</div>
                        <div class="mb-3">Turma: <span class="pauta-badge">{{turma.codigo}}</span></div>
                        <a href="/anosLectivo/pauta3/{{_id}}" class="btn btn-pauta btn-sm mt-auto">Ver Pautas</a>
                    </div>
                </div>
            </div>
            {{else}}
            <div class="col-12">
                <p class="pauta-empty text-center mb-0">Nenhuma pauta da 10ª Classe</p>
            </div>
            {{/each}}
        </div>
    </div>

    <div class="pauta-section">
        <h3 class="pauta-section-title">11ª Classe</h3>
        <div class="row g-3">
            {{#each pautas11}}
            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <div class="card pauta-card h-100 text-center">
