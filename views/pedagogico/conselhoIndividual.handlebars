{{!-- CONSELHO DE NOTA --}}
<h1 class="text-center mark text-success">CONSELHO DE NOTAS EM CURSO...</h1>
<div class="conteiner">
    <div class="row m-0">
        <div class="col-9 text-center p-2 m-0">
            <h2 class="m-0 bg-secondary p-4 text-light"> {{dadosTurma.codigo}}: {{dadosTurma.idClasse.designacao}} -
                {{dadosTurma.idCurso.descricao}} </h2>

        </div>
        <div class="col-3 text-center m-0 p-2">
            <h2 class="mark py-4 m-0 text-secondary">PAUTAS</h2>
        </div>
    </div>
</div>
<hr>

{{#if classeExame}}{{!-- Se for uma classe de exame, mostrar a pauta individual da classe de exame --}}
{{!-- PAUTA INDIVIDUAL DE CLASSE DE EXAME --}}
<div class="">
    <div class="pe-3 lead text-sm mark ">
        <div class="row">
            <div class="col-2">
                <form action="/pedagogico/iniciarConselho" method="post">
                    <input type="hidden" name="idTurma" value="{{dadosTurma._id}}" id="">
                    <input type="hidden" name="idPauta" value="{{idPautaFin}}" id="">
                    <input type="hidden" name="idPresidente" value="{{idPresidente}}" id="">
                    <input type="hidden" name="membro1" value="{{idPresidente}}" id="">
                    <input type="hidden" name="membro2" value="{{idPresidente}}" id="">
                    <input type="hidden" name="membro3" value="{{idPresidente}}" id="">
                    <button type="submit"> < Voltar </button>
                </form>
            </div>
            <div class="col-7 text-end"> Ilustres Membros do Conselho. Tenham o cuidado com os campos abertos. Nenhum deve estar sem nota!  </div>
            <div class="col-3 text-end">Nº Ordem: {{notasIndividual.numOrdem}} </div>
        </div>

    </div>
    <div class="text-center">

        <div class="mt-3 lead fw-bold text-danger"> {{notasIndividual.nome}} </div>
    </div>

    <table class="table table-bordered table-sm tabText-size-12">
        <thead class=" mybg-info">
            <tr class="text-center">

                {{#each disciplinasOrdenadas}}
                <td class=" px-4 fw-bold" colspan="3"> {{disciplina}} </td>
                {{elese}}{{/each}}
                <td class="py-2 fw-bold" rowspan="2">Obs</td>
            </tr>
            <tr class="fw-bold">
                {{#each disciplinasOrdenadas}}
                <td>MFD</td>
                <td>NEE</td>
                <td class="mybg-info">MF</td>
                {{elese}}{{/each}}
            </tr>
        </thead>
        <tbody>
            <ol>

                <form action="/pedagogico/salvarConselhoIndividual" method="post">
                    <tr>

                        {{#each notasIndividual.notas}}
                        {{#if negativa1}}
                        <td class="text-center text-danger">
                            <input type="number" name="mt1" value="{{medDosTrimestes}}" size="1" class="sizeInp-2" max="20" required>
                        </td>
                        {{else}}<td class="text-center">
                            <input type="number" name="mt1" value="{{medDosTrimestes}}" size="1" class="sizeInp-2" max="20" required>
                        </td>
                        {{/if}}

                        {{#if negativa2}}
                        <td class="text-center text-danger">
                            <input type="number" name="mt2" value="{{examePF}}" size="1" class="sizeInp-2" max="20" required>
                        </td>
                        {{else}}
                        <td class="text-center">
                            <input type="number" name="mt2" value="{{examePF}}" size="1" class="sizeInp-2" max="20" required>
                        </td>
                        {{/if}}


                        {{#if negativa3}}
                        <td class="text-center text-danger mybg-info fw-bold"> {{cf}} </td>
                        {{else}}
                        <td class="text-center mybg-info fw-bold"> {{cf}} </td>
                        {{/if}}
                        {{else}}
                        {{/each}}
                        <td class="text-center"> {{estado}} </td>
                    </tr>

            </ol>
        </tbody>
    </table>
    <hr>
    <div class="text-center">
        <input type="hidden" name="idTurma" value="{{notasIndividual.idTurma}}">
        <input type="hidden" name="numOrdemC" value="{{notasIndividual.numOrdem}}">
        <input type="hidden" name="idPauta" value="{{notasIndividual.idPauta}}">
        <input type="hidden" name="presidente" value="">
        <input type="hidden" name="idPresidente" value="">

        <button type="submit" class="btn btn-success form-control" onclick="continuarConselho()">Confirmar e salvar</button>
    </div>
    </form>
    <hr>
    <div class="text-center">
        <span class="text-danger fw-bold">Alterar apenas as notas convenientes, caso se justifique!</span>
        <p>Depois de ajustar todas as notas, Clicar em <span class="fw-bold text-success"> "Confirmar e salvar" </span> </p>
    </div>
</div>
