{{!-- CONSELHO DE NOTA --}}
<h1 class="text-center mark text-primary">CONSELHO DE NOTAS</h1>
<div class="conteiner">
    <div class="row m-0">
        <div class="col-9 text-center p-2 m-0">
            <h2 class="m-0 bg-secondary p-4 text-light"> {{dadosTurma.codigo}}: {{dadosTurma.idClasse.designacao}} -
                {{dadosTurma.idCurso.descricao}} </h2>

        </div>
        <div class="col-3 text-center m-0 p-2">
            <h2 class="mark py-4 m-0 text-secondary">PAUTAS</h2>
        </div>
    </div>
</div>
<hr>

{{#if classeExame}}{{!-- Se for uma classe de exame, mostrar a pauta para classes de exame --}}
<div class="">
    {{!-- PAUATA FINAL DAS CLASSES DE EXAME --}}
    <div class="pe-3 lead text-sm mark ">
        <div class="row">
            <div class="col-6"><a href="/pedagogico/pautas">
                    < Voltar</a>
            </div>
            <div class="col-6 text-end">Pauta Final</div>
        </div>

    </div>
    <div class="logo text-center mt-3"><img src="/img/logor.png" alt=""></div>
    <div class="text-center">
        <p class="m-1">República de Angola</p>
        <p class="m-1">Governo da Província do Bié</p>
        <p class="m-1">Administração Municipal do Cuito</p>
        <p class="fw-bold">LICEU REI NDUNDUMA DO CUITO</p>

        <div class="h5 myText-primary2 fw-bold">{{dadosTurma.idCurso.descricao}}</div>
        <div class="h6 text-center myText-primary2"> <span class="text-dark fw-bold "> Ano Lectivo: </span>
            {{anoLectivo.codigo}} &shy;&shy; {{dadosTurma.idClasse.designacao}} &shy; &shy; &shy; &shy; &shy; &shy;
            <span class="text-dark fw-bold ">Turma: </span> {{dadosTurma.codigo}} &shy; &shy; &shy; <span
                class="text-dark fw-bold ">Período: </span> {{dadosTurma.periodo}}
        </div>
        <div class="mt-3 lead fw-bold text-danger">PAUTA FINAL</div>
    </div>

    <table class="table table-bordered table-sm tabText-size-8">
        <thead class=" mybg-info">
            <tr class="text-center">
                <td class="fw-bold" rowspan="2">N/O</td>
                <td class="lg-cab-nome fw-bold" rowspan="2">Nome Completo</td>
                {{#each disciplinasOrdenadas}}
                <td class=" px-4 fw-bold" colspan="3"> {{disciplina}} </td>
                {{elese}}{{/each}}
                <td class="mybg-info" rowspan="2">Media</td>

                <td class="py-2 fw-bold" rowspan="2">Obs</td>
            </tr>
            <tr class="fw-bold">
                {{#each disciplinasOrdenadas}}
                <td>MFD</td>
                <td>NEE</td>
                <td class="mybg-info">MF</td>
                {{elese}}{{/each}}
            </tr>
        </thead>
        <tbody>
            <ol>

                {{#each pautaF}}

                <tr>
                    <td class="text-center">
                        {{numOrdem}}
                    </td>
                    <td class="lg-cab-nome"> {{nome}} </td>
                    {{#each notas}}
                    {{#if negativa1}} <td class="text-center text-danger"> {{medDosTrimestes}} </td> {{else}}<td
                        class="text-center"> {{medDosTrimestes}} </td>{{/if}}
                    {{#if negativa2}} <td class="text-center text-danger"> {{examePF}} </td> {{else}}<td
                        class="text-center"> {{examePF}} </td>{{/if}}
                    {{#if negativa3}} <td class="text-center text-danger mybg-info"> {{cf}} </td> {{else}}<td
                        class="text-center mybg-info"> {{cf}} </td>{{/if}}
                    {{else}}
                    {{/each}}
                    {{#if negativa4}} <td class="text-center text-danger mybg-info fw-bold"> {{media}} </td> {{else}}<td
                        class="text-center mybg-info fw-bold"> {{media}} </td>{{/if}}
                    {{#if reprovar}}<td class="text-danger"> {{estado}} </td>{{else}} {{/if}}
                    {{#if aprovar}}<td class=""> {{estado}} </td>{{else}}  {{/if}}
                    {{#if desistente}}<td class="mybg-info opacity-50 fw-bold"> {{estado}} </td>{{else}}  {{/if}}
                    {{#if recurso}}<td class=" opacity-50 text-success fw-bold"> {{estado}} </td>{{else}}  {{/if}}

                </tr>
                {{else}}
                <div class="lead text-light text-center bg-danger">Ainda não foi gerada a pauta Final</div>
                {{/each}}

            </ol>
        </tbody>
        
    </table>
    <hr>
    <div class="text-center">
        {{#if idPautaFin}}
        <button class="btn btn-sm btn-primary opacity-50" onclick="iniciarConselho()">Iniciar Conselho de Notas</button>
        {{else}}
        <div class="text-italic text-center text-danger mark">Connsulte o administrador para gerar a pauta desta turma!
        </div>
        {{/if}}
    </div>
</div>
{{else}}{{!-- Se não for uma classe de exame, mostrar pauta das classes de transição --}}

{{!-- P A U T A F I N A L  DAS CLASSES DE TRANSIÇÃO--}}
<div class="">
    <div class="pe-3 lead text-sm mark ">
        <div class="row">
            <div class="col-6"><a href="/professor/{{idPresidente}}">
                    < Voltar</a>
            </div>
            <div class="col-6 text-end">Pauta Final</div>
        </div>

    </div>
    <div class="logo text-center mt-3"><img src="/img/logor.png" alt=""></div>
    <div class="text-center">
        <p class="m-1">República de Angola</p>
        <p class="m-1">Governo da Província do Bié</p>
        <p class="m-1">Administração Municipal do Cuito</p>
        <p class="fw-bold">LICEU REI NDUNDUMA DO CUITO</p>

        <div class="h5 myText-primary2 fw-bold">{{dadosTurma.idCurso.descricao}}</div>
        <div class="h6 text-center myText-primary2"> <span class="text-dark fw-bold "> Ano Lectivo: </span>
            {{anoLectivo.codigo}} &shy;&shy; {{dadosTurma.idClasse.designacao}} &shy; &shy; &shy; &shy; &shy; &shy;
            <span class="text-dark fw-bold ">Turma: </span> {{dadosTurma.codigo}} &shy; &shy; &shy; <span
                class="text-dark fw-bold ">Período: </span> {{dadosTurma.periodo}}
        </div>
        <div class="mt-3 lead fw-bold text-danger">PAUTA FINAL</div>
    </div>

    <table class="table table-bordered table-sm tabText-size-8">
        <thead class=" mybg-info">
            <tr class="text-center">
                <td class="fw-bold" rowspan="2">N/O</td>
                <td class="lg-cab-nome fw-bold" rowspan="2">Nome Completo</td>
                {{#each disciplinasOrdenadas}}
                <td class=" px-4 fw-bold" colspan="4"> {{disciplina}} </td>
                {{elese}}{{/each}}
                <td class="py-2 fw-bold" rowspan="2">Obs</td>
            </tr>
            <tr class="fw-bold">
                {{#each disciplinasOrdenadas}}
                <td>MT1</td>
                <td>MT2</td>
                <td>MT3</td>
                <td class="mybg-info">MF</td>
                {{elese}}{{/each}}
            </tr>
        </thead>
        <tbody>
            <ol>

                {{#each pautaF}}

                <tr>
                    <td class="text-center">
                        {{numOrdem}}
                    </td>
                    <td class="lg-cab-nome"> {{nome}} </td>
                    {{#each notas}}
                    {{#if negativa1}} <td class="text-center text-danger"> {{mt1}} </td> {{else}}<td
                        class="text-center"> {{mt1}} </td>{{/if}}
                    {{#if negativa2}} <td class="text-center text-danger"> {{mt2}} </td> {{else}}<td
                        class="text-center"> {{mt2}} </td>{{/if}}
                    {{#if negativa3}} <td class="text-center text-danger"> {{mt3}} </td> {{else}}<td
                        class="text-center"> {{mt3}} </td>{{/if}}
                    {{#if negativa4}} <td class="text-center text-danger mybg-info fw-bold"> {{mf}} </td> {{else}}<td
                        class="text-center mybg-info fw-bold"> {{mf}} </td>{{/if}}
                    {{else}}
                    {{/each}}
                    {{#if naoApto}}<td class="text-danger"> {{estado}} </td>{{else}} <td> {{estado}} </td> {{/if}}
                </tr>
                {{else}}
                <div class="lead text-light text-center bg-danger">Ainda não foi gerada a pauta Final</div>
                {{/each}}

            </ol>
        </tbody>
    </table>
    <hr>
    <div class="text-center">
        {{#if idPautaFin}}
        <button class="btn btn-sm btn-primary opacity-50" onclick="iniciarConselho()">Iniciar Conselho de Notas</button>
        {{else}}
        <div class="text-italic text-center text-danger mark">Connsulte o administrador para gerar a pauta desta turma!
        </div>
        {{/if}}
    </div>
    <hr>
</div>
 {{/if}} {{!-- FIM, se for ou não classes de exame--}}







<!-- Modal preencger Juris e iniciar conselho -->

<div class="modal" tabindex="-1" data-bs-backdrop="static" id="iniciarConselho">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/pedagogico/iniciarConselho" method="post">
            <div class="modal-content">
                <div class=" text-center mt-3">
                    <div class="modal-title p-2 h3 mark opacity-50 text-center">Membros do Conselho</div>
                </div>
                <hr>
                <span class="text-sm text-italic text-center text-danger ">Preencha por favor outros Membros do Conselho
                    como testemunhas</span>
                <hr>
                <div class="modal-body input-box-filtro">
                    <div class="px-4">
                        <div class="text-center"><span class="fw-bold mb-">Presidente:</span> <span
                                class="fw-bold text-primary"> {{presidente.nome}} </span></div>
                        <hr>
                        <div class="mt-2"> <span class="text-italic mt-2 me-2"> 1º Membro/Vogal <span
                                    class="text-danger">*</span> </span> <input type="text" name="membro1"
                                class="form-controll" placeholder="Insira o nome do Membro (Obrigatório)" required>
                        </div>
                        <hr>
                        <div class="mt-2"> <span class="text-italic me-2"> 2º Membro/Vogal <span
                                    class="text-danger">*</span> </span> <input type="text" name="membro2"
                                class="form-controll" placeholder="Insira o nome do Membro (Obrigatório)" required>
                        </div>
                        <hr>
                        <div class="mt-2"> <span class="text-italic me-2"> 3º Membro/Vogal </span> <input type="text"
                                name="membro3" class="form-controll" placeholder="Insira o nome do Membro"></div>


                    </div>

                    <input type="hidden" name="idTurma" value="{{dadosTurma._id}}" id="">
                    <input type="hidden" name="idPauta" value="{{idPautaFin}}" id="">
                    <input type="hidden" name="idPresidente" value="{{idPresidente}}" id="">
                    <input type="hidden" name="nomePresidente" value="{{presidente.nome}}" id="">

                </div>
                <div class="modal-footer">
                    <div class="text-italic text-info">
                        ( <span class="text-danger">*</span> ) - Campos obrigatórios
                    </div>
                    <div>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Continuar</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>


<script src="assets/bootstrap.bundle.min.js" class="img-fluid"></script>
<script>
    function iniciarConselho() {

        let el = document.getElementById('iniciarConselho');
        let minha_modal = new bootstrap.Modal(el);
        minha_modal.show();
    }



</script>