<div class="conteiner">
    <div class="row m-0">
        <div class="col-9 text-center p-2 m-0">
            <h2 class="m-0 bg-secondary p-4 text-light"> {{dadosTurma.codigo}}: {{dadosTurma.idClasse.designacao}} -
                {{dadosTurma.idCurso.descricao}} </h2>

        </div>
        <div class="col-3 text-center m-0 p-2">
            <h2 class="mark py-4 m-0 text-secondary">PAUTAS</h2>
        </div>
    </div>
</div>
<hr>
{{!-- P R I M E I R O T R I M E S T R E --}}
<div class="">
    <div class="pe-3 lead text-sm mark ">
        <div class="row">
            <div class="col-6"><a href="/pedagogico/pautas"> < Voltar</a></div>
            <div class="col-6 text-end">Primeiro Trimestre</div>
        </div>
        
        </div>
    <div class="logo text-center mt-3"><img src="/img/logor.png" alt=""></div>
    <div class="text-center">
        <p class="m-1">República de Angola</p>
        <p class="m-1">Governo da Província do Bié</p>
        <p class="m-1">Administração Municipal do Cuito</p>
        <p class="fw-bold">LICEU REI NDUNDUMA DO CUITO</p>

        <div class="mt-3 lead">PAUTA DO Iº TRIMESTRE</div>
    </div>
    <div class="row">
        <div class="col-6"> {{dadosTurma.idClasse.designacao}} </div>
        <div class="col-5 text-end"> <span class="fw-bold">Período:</span> <span> {{dadosTurma.periodo}} </span> </div>
    </div>
    <div class=""> <span class="fw-bold">Turma: </span> <span> {{dadosTurma.codigo}} </span></div>
    <table class="table table-bordered table-sm tabText-size-8">
        <thead class="table-secondary bg-orang">
            <tr class="text-center">
                <td class="fw-bold" rowspan="2">N/O</td>
                <td class="lg-cab-nome fw-bold" rowspan="2" >Nome Completo</td>
                {{#each disciplinas}}
                <td class=" px-4 fw-bold" colspan="4"> {{disciplina}} </td>
                {{else}}
                {{/each}}
            </tr>
            <tr class="fw-bold">
                {{#each disciplinas}}
                 <td>MAC</td>
                 <td>PP</td>
                 <td>PT1</td>
                 <td class="mybg-info">MPT1</td>
                 {{else}}{{/each}}
                 <td>MFT1</td>
                 </tr>
        </thead>
        <tbody>
            <ol>

                {{#each pautaT1}}

                <tr>
                    <td class="text-center">
                        {{numOrdem}}
                    </td>
                    <td class="lg-cab-nome" > {{nome}} </td>
                    {{#each notas.notas}}
                    {{#if negativa1}} <td class="text-center text-danger"> {{mac1}} </td> {{else}}<td class="text-center"> {{mac1}} </td>{{/if}}
                    {{#if negativa2}} <td class="text-center text-danger"> {{pp1}} </td> {{else}}<td class="text-center"> {{pp1}} </td>{{/if}}
                    {{#if negativa3}} <td class="text-center text-danger"> {{pt1}} </td> {{else}}<td class="text-center"> {{pt1}} </td>{{/if}}
                    {{#if negativa4}} <td class="text-center text-danger mybg-info fw-bold"> {{mt1}} </td> {{else}}<td class="text-center mybg-info fw-bold"> {{mt1}} </td>{{/if}}
                    {{else}}
                    {{/each}}
                    <td> {{media}} </td>
                </tr>
                {{else}}
                <div class="lead text-light text-center bg-danger">Ainda não foi gerada a pauta do Iª Trimestre</div>
                {{/each}}

            </ol>
        </tbody>
    </table>
    <div class="text-center">
    <form action="/pedagogico/eliminarPauta" method="post">
        <a href="/relatorios/pautaTrimestral/{{dadosTurma._id}}" class="btn btn-secondary">Gerar
            PDF - Pauta Iº Trimestre</a>
            <input type="hidden" name="idTurma" value="{{dadosTurma._id}}" id="">
            <input type="hidden" name="idPauta" value="{{idPautaT1}}" id="">
            <button type="submit" class="btn btn-danger">Eliminar Pauta</button>
            </form>
            </div>
    <hr>
</div>{{!-- FIM Iº TRIMESTRE--}}


