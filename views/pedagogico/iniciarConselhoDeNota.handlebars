    </div>
    <hr>
</div>
{{/if}} {{!-- FIM, se for classe de Exame--}}





<!-- Modal Finalizar Conselho de notas -->

<div class="modal" tabindex="-1" data-bs-backdrop="static" id="finalizarConselho">
    <div class="modal-dialog modal-dialog-centered">
        <form action="/pedagogico/finalizarConseNotas" method="post">
            <div class="modal-content">
                <div class=" text-center mt-3">
                    <div class="modal-title p-2 h3 mark opacity-50 text-center"> Finalizar Conselho de Notas</div>
                </div>
                <hr>
                <span class="text-sm text-italic text-center text-danger "> <span
                        class="text-danger fw-bold">Atensão!</span> <br> Certifica-se de que verificou as chances de
                    todos alunos da turma antes de finalizar </span>
                <hr>
                <div class="modal-body input-box-filtro">
                    <div class="px-4">
                        <div class="text-center"><span class="fw-bold mb-">Presidente:</span> <span
                                class="fw-bold text-primary"> {{presidente.nome}} </span></div>
                        <hr>
                        <div class="mt-2"> <span class="text-italic mt-2 me-2"> 1º Membro/Vogal: </span>  {{membrosConselho.membro1}}  </div>
                        <hr>
                        <div class="mt-2"> <span class="text-italic me-2"> 2º Membro/Vogal: </span> {{membrosConselho.membro2}} </div>
                        <hr>
                        <div class="mt-2"> <span class="text-italic me-2"> 3º Membro/Vogal: </span>  {{membrosConselho.membro3}} </div>


                    </div>

                    <input type="hidden" name="idTurma" value="{{dadosTurma._id}}" id="">
                    <input type="hidden" name="idPauta" value="{{pautaFDoConselho._id}}" id="">

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Finalizar Conselho</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Modal Instrução do Conselho de notas -->
<div class="modal" tabindex="-1" data-bs-backdrop="static" id="instrucaoConselho">
    <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class=" text-center mt-3">
                    <div class="modal-title p-2 h3 mark opacity-50 text-center"> Instrução</div>
                </div>
                <hr>
                    <div class="px-5 text-justify">
                        <span class="text-center text-danger">
                        O conselho é aplicado individualmente a cada aluno que esteja na condição de merecer uma apreciação dos membros que compõe o Conselho. Para o efeito:
                        </span>
                        <p class=" mt-2">1º Identificar o aluno que esteja na condição acima referida;</p>
                        <p class="">2º Clicar em "Conselhar", na última coluna, no número correspondente ao número de ordem do aluno;</p>
                        <p class="">3º Realizar o conselho, atravéz das médias trimestral do aluno;</p>  
                        <p class="">4º Clicar em confirmar e salvar;</p>  
                        <p class="">5º Identificar outo aluno, se existir, e repete os passos;</p>  
                        <p class="">6º Depois de realizar o conselho em cada aluno que estiverem na condição de merecer, clica em "Finalizar conselho de Notas";</p>  
                    </div>
                <hr>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                </div>
            </div>
    </div>
</div>


<script src="assets/bootstrap.bundle.min.js" class="img-fluid"></script>
<script>
    function finalizarConselho() {

        let el = document.getElementById('finalizarConselho');
        let minha_modal = new bootstrap.Modal(el);
        minha_modal.show();
    }

    function instrucaoConselho() {

        let el = document.getElementById('instrucaoConselho');
        let minha_modal = new bootstrap.Modal(el);
        minha_modal.show();
    }



</script>