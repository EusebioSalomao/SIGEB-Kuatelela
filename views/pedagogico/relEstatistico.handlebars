<section class="rel-estatistico">

    <div class="row align-items-center gy-2 rel-estatistico-header">
        <div class="col-12 col-sm-6">
            <h2 class="rel-estatistico-title mb-0">A P R O V E I T A M E N T O</h2>
        </div>
        <div class="col-12 col-sm-6 text-center text-sm-end">
            <span class="badge rel-estatistico-badge">{{trimestre}}</span>
        </div>
    </div>

    <hr class="rel-estatistico-divider">

    {{#if cursoCH}}
    {{#each aproveitamento}}
    {{!-- CURSO DE CIENCIAS HUMANAS --}}
    <div class="table-responsive rel-estatistico-table-wrapper mb-4">
        <table class="table table-bordered table-striped table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="rel-estatistico-section-title text-center" colspan="11">CURSO DE CIENCIAS HUMANAS</th>
                </tr>
                <tr class="text-center fw-bold">
                    <th colspan="3">Matriculados</th>
                    <th colspan="2" class="table-danger">Desistidos</th>
                    <th colspan="2">Chegados ao Fim</th>
                    <th colspan="2">Com Aproveitamento</th>
                    <th colspan="2">Sem Aproveitamento</th>
                </tr>
                <tr class="text-center fw-bold">
                    <th>Classes</th>
                    <th>MF</th><th>F</th>
                    <th>MF</th><th>F</th>
                    <th>MF</th><th>F</th>
                    <th>MF</th><th>F</th>
                    <th>MF</th><th>F</th>
                </tr>
            </thead>

            <tbody>
                <tr class="text-center">
                    <td>10ª Classe</td>
                    <td>{{matric10ClasseCH.length}}</td><td>{{matric10ClasseCHfeminino}}</td>
                    <td>{{matric10ClasseCHdesistMF}}</td><td>{{matric10ClasseCHdesistFeminino}}</td>
                    <td>{{matric10ClasseCHchegadAoFimMF}}</td><td>{{matric10ClasseCHchegadAoFimFeminino}}</td>
                    <td>{{matric10ClasseCHapvMF}}</td><td>{{matric10ClasseCHapvFeminino}}</td>
                    <td>{{matric10ClasseCHsemApvMF}}</td><td>{{matric10ClasseCHsemApvFeminino}}</td>
                </tr>
                <tr class="text-center">
                    <td>11ª Classe</td>
                    <td>{{matric11ClasseCH.length}}</td><td>{{matric11ClasseCHfeminino}}</td>
                    <td>{{matric11ClasseCHdesistMF}}</td><td>{{matric11ClasseCHdesistFeminino}}</td>
                    <td>{{matric11ClasseCHchegadAoFimMF}}</td><td>{{matric11ClasseCHchegadAoFimFeminino}}</td>
