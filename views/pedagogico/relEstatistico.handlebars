                    <td>{{matric12ClasseCHsemApvMF}}</td><td>{{matric12ClasseCHsemApvFeminino}}</td>
                </tr>
                <tr class="text-center fw-bold rel-estatistico-total-row">
                    <td>TOTAL</td>
                    <td>{{totalCH.mf}}</td><td>{{totalCH.feminino}}</td>
                    <td colspan="4"></td>
                    <td>{{totalCH.totalComApMF}}</td><td>{{totalCH.totalComApFeminino}}</td>
                    <td>{{totalCH.totalSemApMF}}</td><td>{{totalCH.totalSemApFeminino}}</td>
                </tr>
            </tbody>
        </table>
    </div>
    {{/each}}
    {{else}}

